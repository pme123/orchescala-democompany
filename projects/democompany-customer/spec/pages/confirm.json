{
  "path": "appointments/confirm",
  "title": "Termin bestätigen",
  "access": {
    "roles": [
      "kundenberater"
    ]
  },
  "state": {
    "step": "decide"
  },
  "load": [
    {
      "do": "call",
      "service": "democompany-customer-appointmentToConfirm",
      "input": {
        "token": "{{query.token}}"
      },
      "result": "task",
      "errors": {
        "403": "Dafür braucht es die Rolle «kundenberater».",
        "404": "Zu diesem Link gibt es keinen Termin (mehr) – die Reservierung ist abgelaufen oder abgelehnt."
      }
    }
  ],
  "body": [
    {
      "type": "heading",
      "text": "Termin bestätigen",
      "id": "b-693df07278"
    },
    {
      "type": "loading",
      "text": "Termin laden …",
      "id": "b-9150d143ea"
    },
    {
      "type": "summary",
      "label": "Anfrage",
      "visible": "task",
      "items": [
        {
          "label": "Wann",
          "value": "{{task.appointment.start|datetime}}–{{task.appointment.end|time}}"
        },
        {
          "label": "Thema",
          "value": "{{task.appointment.topic|label:topic}}, {{task.appointment.channel|label:channel}}"
        },
        {
          "label": "Kunde",
          "value": "{{task.contact.firstName}} {{task.contact.lastName}}"
        },
        {
          "label": "E-Mail",
          "value": "{{task.contact.email}}"
        },
        {
          "label": "Telefon",
          "value": "{{task.contact.phone}}"
        },
        {
          "label": "Kunden-Nr.",
          "value": "{{task.contact.customerNo}}"
        },
        {
          "label": "Bemerkung",
          "value": "{{task.remark}}"
        },
        {
          "label": "Status",
          "value": "{{task.status|label:status}}"
        }
      ],
      "id": "b-d8602dcc43"
    },
    {
      "type": "text",
      "tone": "info",
      "visible": "task && !task.taskId && task.status == 'booked'",
      "text": "Dieser Termin ist schon gebucht – die Einladung ist verschickt.",
      "id": "b-bb28e224fc"
    },
    {
      "type": "text",
      "tone": "info",
      "visible": "task && !task.taskId && task.status == 'reserved'",
      "text": "Hier ist nichts zu bestätigen – der Kunde hat seine E-Mail-Adresse noch nicht bestätigt.",
      "id": "b-c12ca295bc"
    },
    {
      "type": "section",
      "label": "Bestätigen",
      "visible": "task.taskId && step == 'decide'",
      "body": [
        {
          "type": "choice",
          "bind": "accepted",
          "label": "Ihr Entscheid",
          "required": true,
          "options": [
            {
              "value": true,
              "label": "Annehmen",
              "hint": "Einladung an Kunde und mich"
            },
            {
              "value": false,
              "label": "Ablehnen",
              "hint": "mit Begründung an den Kunden"
            }
          ],
          "id": "b-171e62d10a"
        },
        {
          "type": "fields",
          "fields": [
            {
              "bind": "declineReason",
              "label": "Begründung – geht an den Kunden",
              "input": "textarea",
              "required": true,
              "visible": "accepted == false"
            }
          ],
          "id": "b-604efa51b8"
        },
        {
          "type": "button",
          "label": "Entscheid senden",
          "validate": true,
          "actions": [
            {
              "do": "completeTask",
              "taskKey": "ConfirmAppointmentTask",
              "taskId": "{{task.taskId}}",
              "input": {
                "accepted": "{{accepted}}",
                "declineReason": "{{declineReason}}"
              },
              "errors": {
                "404": "Der Task ist schon erledigt.",
                "default": "Der Entscheid ging nicht durch – bitte noch einmal versuchen."
              }
            },
            {
              "do": "set",
              "path": "step",
              "value": "done"
            }
          ],
          "id": "b-cca5fcf6a5"
        }
      ],
      "id": "b-0c2b47c711"
    },
    {
      "type": "text",
      "tone": "success",
      "visible": "step == 'done' && accepted == true",
      "text": "Angenommen – die Einladung geht an den Kunden und an Sie.",
      "id": "b-01e169b911"
    },
    {
      "type": "text",
      "tone": "success",
      "visible": "step == 'done' && accepted == false",
      "text": "Abgelehnt – der Kunde erhält Ihre Begründung per E-Mail.",
      "id": "b-5ab89c7e93"
    }
  ],
  "spec": {
    "project": "democompany-customer",
    "epics": [
      "kundentermin"
    ]
  }
}
