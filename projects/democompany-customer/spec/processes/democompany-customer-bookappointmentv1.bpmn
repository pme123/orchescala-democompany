<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_democompany-customer-bookAppointmentV1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_democompany-customer-bookAppointmentV1">
    <bpmn:participant id="democompany-customer-bookAppointmentV1-participant" name="Termin vereinbaren" processRef="democompany-customer-bookAppointmentV1" />
  </bpmn:collaboration>
  <bpmn:process id="democompany-customer-bookAppointmentV1" name="Termin vereinbaren" isExecutable="true" camunda:historyTimeToLive="5">
    <bpmn:startEvent id="StartProcessStartEvent" name="Termin reserviert" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_StartProcessStartEvent_InitProcessTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="InitProcessTask" name="Init Process" camunda:type="external" camunda:topic="democompany-customer-bookAppointmentV1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="handledErrors">output-mocked</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartProcessStartEvent_InitProcessTask</bpmn:incoming>
      <bpmn:outgoing>Flow_InitProcessTask_SendVerificationEmailTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="OutputmockedBoundaryEvent" name="output-mocked" cancelActivity="true" attachedToRef="InitProcessTask">
      <bpmn:outgoing>Flow_OutputmockedBoundaryEvent_OutputmockedEvent1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_output-mocked" errorRef="Error_output-mocked" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="OutputmockedEvent1" name="output-mocked">
      <bpmn:incoming>Flow_OutputmockedBoundaryEvent_OutputmockedEvent1</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_throw" name="output-mocked" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="SendVerificationEmailTask" name="E-Mail-Bestätigung senden" camunda:type="external" camunda:topic="democompany-services-mailsV1-SendEmail">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="to">#{email}</camunda:inputParameter>
          <camunda:inputParameter name="subject">Bitte bestätigen Sie Ihre Terminanfrage</camunda:inputParameter>
          <camunda:inputParameter name="body">Guten Tag #{customerName}\n\nBitte bestätigen Sie Ihre Terminanfrage (#{appointmentText}) mit diesem Link:\n#{verificationLink}\n\nFreundliche Grüsse\nDemo Company</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InitProcessTask_SendVerificationEmailTask</bpmn:incoming>
      <bpmn:outgoing>Flow_SendVerificationEmailTask_VerifyEmailGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="VerifyEmailGateway">
      <bpmn:incoming>Flow_SendVerificationEmailTask_VerifyEmailGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyEmailGateway_EmailVerifiedEvent</bpmn:outgoing>
      <bpmn:outgoing>Flow_VerifyEmailGateway_VerificationExpiredEvent</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="EmailVerifiedEvent" name="E-Mail bestätigt">
      <bpmn:incoming>Flow_VerifyEmailGateway_EmailVerifiedEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_EmailVerifiedEvent_AssignCustomerTask</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_emailVerified" messageRef="Message_emailVerified" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="VerificationExpiredEvent" name="nicht bestätigt">
      <bpmn:incoming>Flow_VerifyEmailGateway_VerificationExpiredEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_VerificationExpiredEvent_ReleaseExpiredReservationTask</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_verify">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timerVerifyEmail}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ReleaseExpiredReservationTask" name="Reservierung freigeben" camunda:type="external" camunda:topic="democompany-customer-bookAppointmentV1-ReleaseReservation">
      <bpmn:incoming>Flow_VerificationExpiredEvent_ReleaseExpiredReservationTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseExpiredReservationTask_NotVerifiedEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="NotVerifiedEndEvent" name="nicht bestätigt">
      <bpmn:extensionElements>
        <camunda:executionListener expression="#{execution.setVariable(&#34;processStatus&#34;, &#34;notVerified&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReleaseExpiredReservationTask_NotVerifiedEndEvent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="AssignCustomerTask" name="Kunde zuordnen" camunda:type="external" camunda:topic="democompany-customer-bookAppointmentV1-AssignCustomer">
      <bpmn:incoming>Flow_EmailVerifiedEvent_AssignCustomerTask</bpmn:incoming>
      <bpmn:outgoing>Flow_AssignCustomerTask_AppointmentRulesTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="AppointmentRulesTask" name="Terminregeln" camunda:decisionRef="democompany-customer-bookAppointmentV1-AppointmentRules" camunda:resultVariable="rules" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_AssignCustomerTask_AppointmentRulesTask</bpmn:incoming>
      <bpmn:outgoing>Flow_AppointmentRulesTask_ConfirmationRequiredGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ConfirmationRequiredGateway" name="Bestätigung nötig?" default="NoConfirmationFlow">
      <bpmn:incoming>Flow_AppointmentRulesTask_ConfirmationRequiredGateway</bpmn:incoming>
      <bpmn:outgoing>ConfirmationFlow</bpmn:outgoing>
      <bpmn:outgoing>NoConfirmationFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NotifyAdvisorTask" name="Berater benachrichtigen" camunda:type="external" camunda:topic="democompany-services-mailsV1-SendEmail">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="to">#{advisorEmail}</camunda:inputParameter>
          <camunda:inputParameter name="subject">Neue Terminanfrage</camunda:inputParameter>
          <camunda:inputParameter name="body">Neue Terminanfrage von #{customerName}: #{appointmentText}\n\nBitte bestätigen oder ablehnen:\n#{confirmLink}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>ConfirmationFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyAdvisorTask_ConfirmAppointmentTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ConfirmAppointmentTask" name="Termin bestätigen" camunda:candidateGroups="kundenberater">
      <bpmn:incoming>Flow_NotifyAdvisorTask_ConfirmAppointmentTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmAppointmentTask_AcceptedGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="ConfirmReminderEvent" name="nach 1 Arbeitstag" cancelActivity="false" attachedToRef="ConfirmAppointmentTask">
      <bpmn:outgoing>Flow_ConfirmReminderEvent_SendReminderTask</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_reminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timerConfirmReminder}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="SendReminderTask" name="Erinnerung senden" camunda:type="external" camunda:topic="democompany-services-mailsV1-SendEmail">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="to">#{advisorEmail}</camunda:inputParameter>
          <camunda:inputParameter name="subject">Erinnerung: Terminanfrage offen</camunda:inputParameter>
          <camunda:inputParameter name="body">Die Terminanfrage von #{customerName} (#{appointmentText}) ist noch offen:\n#{confirmLink}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ConfirmReminderEvent_SendReminderTask</bpmn:incoming>
      <bpmn:outgoing>Flow_SendReminderTask_ReminderSentEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ReminderSentEndEvent" name="erinnert">
      <bpmn:incoming>Flow_SendReminderTask_ReminderSentEndEvent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="AcceptedGateway" name="angenommen?">
      <bpmn:incoming>Flow_ConfirmAppointmentTask_AcceptedGateway</bpmn:incoming>
      <bpmn:outgoing>AcceptedFlow</bpmn:outgoing>
      <bpmn:outgoing>DeclinedFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReleaseDeclinedReservationTask" name="Reservierung freigeben" camunda:type="external" camunda:topic="democompany-customer-bookAppointmentV1-ReleaseReservation">
      <bpmn:incoming>DeclinedFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseDeclinedReservationTask_SendDeclinedEmailTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SendDeclinedEmailTask" name="Absage senden" camunda:type="external" camunda:topic="democompany-services-mailsV1-SendEmail">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="to">#{email}</camunda:inputParameter>
          <camunda:inputParameter name="subject">Ihre Terminanfrage</camunda:inputParameter>
          <camunda:inputParameter name="body">Guten Tag #{customerName}\n\nLeider können wir den Termin (#{appointmentText}) nicht wahrnehmen. Bitte wählen Sie auf unserer Homepage einen anderen Termin.\n\nFreundliche Grüsse\nDemo Company</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReleaseDeclinedReservationTask_SendDeclinedEmailTask</bpmn:incoming>
      <bpmn:outgoing>Flow_SendDeclinedEmailTask_DeclinedEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DeclinedEndEvent" name="abgelehnt">
      <bpmn:extensionElements>
        <camunda:executionListener expression="#{execution.setVariable(&#34;processStatus&#34;, &#34;declined&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendDeclinedEmailTask_DeclinedEndEvent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="BookJoinGateway">
      <bpmn:incoming>NoConfirmationFlow</bpmn:incoming>
      <bpmn:incoming>AcceptedFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_BookJoinGateway_BookReservationTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BookReservationTask" name="Termin buchen" camunda:type="external" camunda:topic="democompany-customer-bookAppointmentV1-BookReservation">
      <bpmn:incoming>Flow_BookJoinGateway_BookReservationTask</bpmn:incoming>
      <bpmn:outgoing>Flow_BookReservationTask_SendInvitationTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SendInvitationTask" name="Einladung senden" camunda:type="external" camunda:topic="democompany-customer-bookAppointmentV1-SendInvitation">
      <bpmn:incoming>Flow_BookReservationTask_SendInvitationTask</bpmn:incoming>
      <bpmn:outgoing>Flow_SendInvitationTask_SucceededEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="SucceededEndEvent" name="gebucht">
      <bpmn:extensionElements>
        <camunda:executionListener expression="#{execution.setVariable(&#34;processStatus&#34;, &#34;succeeded&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendInvitationTask_SucceededEndEvent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="OutputmockedEvent" name="output-mocked">
      <bpmn:outgoing>Flow_OutputmockedEvent_OutputmockedEndEvent</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkEventDefinition_catch" name="output-mocked" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="OutputmockedEndEvent" name="output-mocked">
      <bpmn:extensionElements>
        <camunda:executionListener expression="#{execution.setVariable(&#34;processStatus&#34;, &#34;output-mocked&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OutputmockedEvent_OutputmockedEndEvent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OutputmockedBoundaryEvent_OutputmockedEvent1" sourceRef="OutputmockedBoundaryEvent" targetRef="OutputmockedEvent1" />
    <bpmn:sequenceFlow id="Flow_StartProcessStartEvent_InitProcessTask" sourceRef="StartProcessStartEvent" targetRef="InitProcessTask" />
    <bpmn:sequenceFlow id="Flow_InitProcessTask_SendVerificationEmailTask" sourceRef="InitProcessTask" targetRef="SendVerificationEmailTask" />
    <bpmn:sequenceFlow id="Flow_SendVerificationEmailTask_VerifyEmailGateway" sourceRef="SendVerificationEmailTask" targetRef="VerifyEmailGateway" />
    <bpmn:sequenceFlow id="Flow_VerifyEmailGateway_EmailVerifiedEvent" sourceRef="VerifyEmailGateway" targetRef="EmailVerifiedEvent" />
    <bpmn:sequenceFlow id="Flow_VerifyEmailGateway_VerificationExpiredEvent" sourceRef="VerifyEmailGateway" targetRef="VerificationExpiredEvent" />
    <bpmn:sequenceFlow id="Flow_VerificationExpiredEvent_ReleaseExpiredReservationTask" sourceRef="VerificationExpiredEvent" targetRef="ReleaseExpiredReservationTask" />
    <bpmn:sequenceFlow id="Flow_ReleaseExpiredReservationTask_NotVerifiedEndEvent" sourceRef="ReleaseExpiredReservationTask" targetRef="NotVerifiedEndEvent" />
    <bpmn:sequenceFlow id="Flow_EmailVerifiedEvent_AssignCustomerTask" sourceRef="EmailVerifiedEvent" targetRef="AssignCustomerTask" />
    <bpmn:sequenceFlow id="Flow_AssignCustomerTask_AppointmentRulesTask" sourceRef="AssignCustomerTask" targetRef="AppointmentRulesTask" />
    <bpmn:sequenceFlow id="Flow_AppointmentRulesTask_ConfirmationRequiredGateway" sourceRef="AppointmentRulesTask" targetRef="ConfirmationRequiredGateway" />
    <bpmn:sequenceFlow id="ConfirmationFlow" name="ja" sourceRef="ConfirmationRequiredGateway" targetRef="NotifyAdvisorTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rules.confirmationRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NoConfirmationFlow" name="nein" sourceRef="ConfirmationRequiredGateway" targetRef="BookJoinGateway" />
    <bpmn:sequenceFlow id="Flow_NotifyAdvisorTask_ConfirmAppointmentTask" sourceRef="NotifyAdvisorTask" targetRef="ConfirmAppointmentTask" />
    <bpmn:sequenceFlow id="Flow_ConfirmAppointmentTask_AcceptedGateway" sourceRef="ConfirmAppointmentTask" targetRef="AcceptedGateway" />
    <bpmn:sequenceFlow id="Flow_ConfirmReminderEvent_SendReminderTask" sourceRef="ConfirmReminderEvent" targetRef="SendReminderTask" />
    <bpmn:sequenceFlow id="Flow_SendReminderTask_ReminderSentEndEvent" sourceRef="SendReminderTask" targetRef="ReminderSentEndEvent" />
    <bpmn:sequenceFlow id="AcceptedFlow" name="ja" sourceRef="AcceptedGateway" targetRef="BookJoinGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DeclinedFlow" name="nein" sourceRef="AcceptedGateway" targetRef="ReleaseDeclinedReservationTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReleaseDeclinedReservationTask_SendDeclinedEmailTask" sourceRef="ReleaseDeclinedReservationTask" targetRef="SendDeclinedEmailTask" />
    <bpmn:sequenceFlow id="Flow_SendDeclinedEmailTask_DeclinedEndEvent" sourceRef="SendDeclinedEmailTask" targetRef="DeclinedEndEvent" />
    <bpmn:sequenceFlow id="Flow_BookJoinGateway_BookReservationTask" sourceRef="BookJoinGateway" targetRef="BookReservationTask" />
    <bpmn:sequenceFlow id="Flow_BookReservationTask_SendInvitationTask" sourceRef="BookReservationTask" targetRef="SendInvitationTask" />
    <bpmn:sequenceFlow id="Flow_SendInvitationTask_SucceededEndEvent" sourceRef="SendInvitationTask" targetRef="SucceededEndEvent" />
    <bpmn:sequenceFlow id="Flow_OutputmockedEvent_OutputmockedEndEvent" sourceRef="OutputmockedEvent" targetRef="OutputmockedEndEvent" />
  </bpmn:process>
