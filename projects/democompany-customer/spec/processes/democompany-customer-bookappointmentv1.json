                              "id": "SendDeclinedEmailTask",
                              "kind": "service",
                              "name": "Absage senden",
                              "status": "implemented",
                              "topic": "democompany-customer-bookAppointmentV1-SendMail",
                              "inputs": [
                                {
                                  "name": "to",
                                  "expression": "= email"
                                },
                                {
                                  "name": "subject",
                                  "expression": "Ihre Terminanfrage"
                                },
                                {
                                  "name": "body",
                                  "expression": "= \"Guten Tag \" + string(customerName) + \"\\\\n\\\\nLeider können wir den Termin (\" + string(appointmentText) + \") nicht wahrnehmen. Bitte wählen Sie auf unserer Homepage einen anderen Termin.\\\\n\\\\nFreundliche Grüsse\\\\nDemo Company\""
                                }
                              ],
                              "manualOutMapping": false
                            },
                            {
                              "id": "DeclinedEndEvent",
                              "kind": "end",
                              "name": "abgelehnt",
                              "status": "implemented"
                            }
                          ]
                        }
                      ]
                    }
