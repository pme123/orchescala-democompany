                              "manualOutMapping": false
                            },
                            {
                              "id": "SucceededEndEvent",
                              "kind": "end",
                              "name": "gebucht",
                              "status": "implemented"
                            }
                          ]
                        },
                        {
                          "id": "DeclinedFlow",
                          "label": "nein",
                          "condition": "= not(accepted)",
                          "steps": [
