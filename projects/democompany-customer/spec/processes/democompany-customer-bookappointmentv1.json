                        {
                          "name": "to",
                          "expression": "= advisorEmail"
                        },
                        {
                          "name": "subject",
                          "expression": "Neue Terminanfrage"
                        },
                        {
                          "name": "body",
                          "expression": "= \"Neue Terminanfrage von \" + string(customerName) + \": \" + string(appointmentText) + \"\\\\n\\\\nBitte bestätigen oder ablehnen:\\\\n\" + string(confirmLink)"
