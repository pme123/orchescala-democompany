                              "id": "ReminderSentEndEvent",
                              "kind": "end",
                              "name": "erinnert",
                              "status": "implemented"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "AcceptedGateway",
                      "kind": "gateway",
                      "name": "angenommen?",
                      "status": "implemented",
                      "gatewayType": "exclusive",
                      "branches": [
                        {
                          "id": "AcceptedFlow",
                          "label": "ja",
                          "condition": "= accepted",
                          "steps": [
                            {
                              "id": "BookReservationTask",
                              "kind": "service",
                              "name": "Termin buchen",
                              "status": "implemented",
                              "topic": "democompany-customer-bookAppointmentV1-BookReservation",
                              "manualOutMapping": false
                            },
