        {
          "name": "subject",
          "expression": "Bitte bestätigen Sie Ihre Terminanfrage"
        },
        {
          "name": "body",
          "expression": "= \"Guten Tag \" + string(customerName) + \"\\\\n\\\\nBitte bestätigen Sie Ihre Terminanfrage (\" + string(appointmentText) + \") mit diesem Link:\\\\n\" + string(verificationLink) + \"\\\\n\\\\nFreundliche Grüsse\\\\nDemo Company\""
