{
  "components": [
    {
      "text": "# Call Client Task\n\nThe Customer Service must call the client due to missing information. Please review the client information below and provide the telephone approval decision.",
      "type": "text",
      "id": "Field_header",
      "layout": {
        "row": "Row_header"
      }
    },
    {
      "text": "## Client Information",
      "type": "text",
      "id": "Field_client_header",
      "layout": {
        "row": "Row_client_header"
      }
    },
    {
      "label": "Client ID",
      "type": "number",
      "id": "Field_client_id",
      "key": "client.id",
      "readonly": true,
      "layout": {
        "row": "Row_client_basic",
        "columns": null
      }
    },
    {
      "label": "First Name",
      "type": "textfield",
      "id": "Field_client_firstName",
      "key": "client.firstName",
      "readonly": true,
      "layout": {
        "row": "Row_client_basic",
        "columns": null
      }
    },
    {
      "label": "Last Name",
      "type": "textfield",
      "id": "Field_client_lastName",
      "key": "client.lastName",
      "readonly": true,
      "layout": {
        "row": "Row_client_name",
        "columns": null
      }
    },
    {
      "label": "Email",
      "type": "textfield",
      "id": "Field_client_email",
      "key": "client.email",
      "readonly": true,
      "layout": {
        "row": "Row_client_name",
        "columns": null
      },
      "conditional": {
        "hide": "=client.email = null"
      }
    },
    {
      "label": "Telephone",
      "type": "textfield",
      "id": "Field_client_tel",
      "key": "client.tel",
      "readonly": true,
      "layout": {
        "row": "Row_client_contact",
        "columns": null
      },
      "conditional": {
        "hide": "=client.tel = null"
      }
    },
    {
      "label": "Salutation",
      "type": "textfield",
      "id": "Field_client_salutation",
      "key": "client.salutation",
      "readonly": true,
      "layout": {
        "row": "Row_client_contact",
        "columns": null
      },
      "conditional": {
        "hide": "=client.salutation = null"
      }
    },
    {
      "subtype": "date",
      "dateLabel": "Date of Birth",
      "type": "datetime",
      "id": "Field_client_dateOfBirth",
      "key": "client.dateOfBirth",
      "readonly": true,
      "layout": {
        "row": "Row_client_dates",
        "columns": null
      },
      "conditional": {
        "hide": "=client.dateOfBirth = null"
      }
    },
    {
      "subtype": "datetime",
      "dateLabel": "Created At",
      "type": "datetime",
      "id": "Field_client_createdAt",
      "key": "client.createdAt",
      "readonly": true,
      "layout": {
        "row": "Row_client_dates",
        "columns": null
      },
      "conditional": {
        "hide": "=client.createdAt = null"
      }
    },
    {
      "subtype": "datetime",
      "dateLabel": "Updated At",
      "type": "datetime",
      "id": "Field_client_updatedAt",
      "key": "client.updatedAt",
      "readonly": true,
      "layout": {
        "row": "Row_client_dates",
        "columns": null
      },
      "conditional": {
        "hide": "=client.updatedAt = null"
      }
    },
    {
      "text": "## Credit Card Account",
      "type": "text",
      "id": "Field_account_header",
      "layout": {
        "row": "Row_account_header"
      }
    },
    {
      "label": "Account Client ID",
      "type": "number",
      "id": "Field_account_clientId",
      "key": "creditCardAccount.clientId",
      "readonly": true,
      "layout": {
        "row": "Row_account_info",
        "columns": null
      }
    },
    {
      "label": "Account ID",
      "type": "number",
      "id": "Field_account_id",
      "key": "creditCardAccount.accountId",
      "readonly": true,
      "layout": {
        "row": "Row_account_info",
        "columns": null
      },
      "conditional": {
        "hide": "=creditCardAccount.accountId = null"
      }
    },
    {
      "text": "## Main Card Holder",
      "type": "text",
      "id": "Field_cardholder_header",
      "layout": {
        "row": "Row_cardholder_header"
      },
      "conditional": {
        "hide": "=mainCardHolder = null"
      }
    },
    {
      "label": "Card Holder Client ID",
      "type": "number",
      "id": "Field_cardholder_clientId",
      "key": "mainCardHolder.clientInformation.clientId",
      "readonly": true,
      "layout": {
        "row": "Row_cardholder_basic",
        "columns": null
      },
      "conditional": {
        "hide": "=mainCardHolder = null"
      }
    },
    {
      "label": "Address Type",
      "type": "select",
      "id": "Field_cardholder_addressType",
      "key": "mainCardHolder.clientInformation.addressType",
      "readonly": true,
      "layout": {
        "row": "Row_cardholder_basic",
        "columns": null
      },
      "conditional": {
        "hide": "=mainCardHolder = null"
      },
      "values": [
        {
          "label": "Domicile",
          "value": "Domicile"
        },
        {
          "label": "Additional",
          "value": "Additional"
        }
      ]
    },
    {
      "label": "Residence Permit Code",
      "type": "select",
      "id": "Field_cardholder_residencePermit",
      "key": "mainCardHolder.clientInformation.residencePermitCode",
      "readonly": true,
      "layout": {
        "row": "Row_cardholder_permit",
        "columns": null
      },
      "conditional": {
        "hide": "=mainCardHolder = null or mainCardHolder.clientInformation.residencePermitCode = null"
      },
      "values": [
        {
          "label": "1",
          "value": 1
        },
        {
          "label": "2",
          "value": 2
        },
        {
          "label": "3",
          "value": 3
        },
        {
          "label": "4",
          "value": 4
        },
        {
          "label": "5",
          "value": 5
        },
        {
          "label": "6",
          "value": 6
        },
        {
          "label": "7",
          "value": 7
        },
        {
          "label": "8",
          "value": 8
        }
      ]
    },
    {
      "label": "Cards",
      "components": [
        {
          "label": "Card Category",
          "type": "select",
          "id": "Field_card_category",
          "key": "categoryType",
          "readonly": true,
          "layout": {
            "row": "Row_card_info",
            "columns": null
          },
          "values": [
            {
              "label": "Main Card",
              "value": "MainCard"
            },
            {
              "label": "Additional Card",
              "value": "AdditionalCard"
            }
          ]
        },
        {
          "label": "Card Limit",
          "type": "number",
          "id": "Field_card_limit",
          "key": "cardLimit",
          "readonly": true,
          "layout": {
            "row": "Row_card_info",
            "columns": null
          },
          "conditional": {
            "hide": "=cardLimit = null"
          }
        },
        {
          "label": "Card Currency",
          "type": "select",
          "id": "Field_card_currency",
          "key": "cardCurrency",
          "readonly": true,
          "layout": {
            "row": "Row_card_details",
            "columns": null
          },
          "conditional": {
            "hide": "=cardCurrency = null"
          },
          "values": [
            {
              "label": "CHF",
              "value": "CHF"
            },
            {
              "label": "EUR",
              "value": "EUR"
            },
            {
              "label": "USD",
              "value": "USD"
            }
          ]
        },
        {
          "label": "Embossed Line",
          "type": "textfield",
          "id": "Field_card_embossed",
          "key": "embossedLineOne",
          "readonly": true,
          "layout": {
            "row": "Row_card_details",
            "columns": null
          }
        }
      ],
      "showOutline": true,
      "isRepeating": true,
      "allowAddRemove": false,
      "defaultRepetitions": 1,
      "type": "dynamiclist",
      "id": "Field_cards_list",
      "path": "mainCardHolder.cards",
      "defaultNumberOfItems": 1,
      "disableCollapse": true,
      "layout": {
        "row": "Row_cards_list"
      },
      "conditional": {
        "hide": "=mainCardHolder = null"
      }
    },
    {
      "text": "## Telephone Approval Decision",
      "type": "text",
      "id": "Field_decision_header",
      "layout": {
        "row": "Row_decision_header"
      }
    },
    {
      "label": "Approved on Telephone",
      "type": "checkbox",
      "id": "Field_approvedOnTelephone",
      "key": "approvedOnTelephone",
      "layout": {
        "row": "Row_decision",
        "columns": null
      }
    },
    {
      "label": "Telephone Approval Comment",
      "type": "textarea",
      "id": "Field_approveOnTelephoneComment",
      "key": "approveOnTelephoneComment",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_comment"
      }
    }
  ],
  "type": "default",
  "id": "CallClientTask",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.6.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.34.0"
  },
  "schemaVersion": 16
}