    <bpmn:serviceTask id="Activity_0vqnakm" name="Send Email" zeebe:modelerTemplate="democompany-services-mailsV1-SendEmail" zeebe:modelerTemplateVersion="0">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="democompany-services-mailsV1-SendEmail" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Missing Information for ordering creditcard.&#34;" target="subject" />
          <zeebe:input source="=&#34;Dear &#34; + client.salutation + &#34;\\n\\n&#34; + &#34;Regards Demo Company&#34;" target="body" />
          <zeebe:input source="=client.email" target="to" />
          <zeebe:input source="=&#34;customerservice@democompany.ch&#34;" target="cc" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tot3tr</bpmn:incoming>
      <bpmn:outgoing>Flow_1pjrvj7</bpmn:outgoing>
