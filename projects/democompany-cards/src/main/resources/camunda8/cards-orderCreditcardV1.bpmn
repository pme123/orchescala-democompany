  <bpmn:collaboration id="Collaboration_0bb63t1">
    <bpmn:participant id="DemocompanycardsorderCreditcardV1Participant" name="democompany-cards-orderCreditcardV1" processRef="democompany-cards-orderCreditcardV1" />
  </bpmn:collaboration>
  <bpmn:process id="democompany-cards-orderCreditcardV1" name="democompany-cards-orderCreditcardV1" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:sequenceFlow id="Flow_15cq5k9" sourceRef="CheckOrderTask" targetRef="ApprovedGateway" />
    <bpmn:sequenceFlow id="Flow_1gt1qt5" sourceRef="StartStartEvent" targetRef="MockedGateway" />
    <bpmn:sequenceFlow id="Flow_1xabbbn" sourceRef="MockedGateway" targetRef="GetClientsClientIdTask" />
    <bpmn:endEvent id="MockedEndEvent" name="mocked">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;output-mocked&#34;" target="processStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>YesSequenceFlow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="MockedGateway" name="mocked?" default="Flow_1xabbbn">
      <bpmn:incoming>Flow_1gt1qt5</bpmn:incoming>
      <bpmn:outgoing>YesSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>Flow_1xabbbn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartStartEvent" name="start">
      <bpmn:extensionElements>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="end" retries="0" type="democompany-cards-orderCreditcardV1" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1gt1qt5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="YesSequenceFlow" name="yes" sourceRef="MockedGateway" targetRef="MockedEndEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isMocked = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="GetClientsClientIdTask" name="Get Clients Client Id" zeebe:modelerTemplate="democompany-services-clientsV1-GetClientsClientId" zeebe:modelerTemplateVersion="0">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="democompany-services-clientsV1-GetClientsClientId" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=clientId" target="clientId" />
          <zeebe:input source="=[ &#34;client&#34;, &#34;email&#34; ]" target="outputVariables" />
          <zeebe:input source="=getClientMock" target="outputMock" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xabbbn</bpmn:incoming>
      <bpmn:outgoing>Flow_1i6wugq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1i6wugq" sourceRef="GetClientsClientIdTask" targetRef="CheckOrderTask" />
    <bpmn:userTask id="CheckOrderTask" name="Check Order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="CheckOrderTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i6wugq</bpmn:incoming>
      <bpmn:outgoing>Flow_15cq5k9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ApprovedGateway" name="approved?">
      <bpmn:incoming>Flow_15cq5k9</bpmn:incoming>
      <bpmn:outgoing>YesSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>NoSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="YesSequenceFlow1" name="yes" sourceRef="ApprovedGateway" targetRef="SuccededEndEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NoSequenceFlow" name="no" sourceRef="ApprovedGateway" targetRef="HasEmailGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(approved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1pjrvj7" sourceRef="SendEmailTask" targetRef="Gateway_0wb6b1z" />
    <bpmn:serviceTask id="SendEmailTask" name="Send Email" zeebe:modelerTemplate="democompany-services-mailsV1-SendEmail" zeebe:modelerTemplateVersion="0">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="democompany-services-mailsV1-SendEmail" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Missing Information for ordering creditcard.&#34;" target="subject" />
          <zeebe:input source="=&#34;Dear &#34; + client.salutation + &#34;\\n\\n&#34; + &#34;Regards Demo Company&#34;" target="body" />
          <zeebe:input source="=client.email" target="to" />
          <zeebe:input source="=&#34;customerservice@democompany.ch&#34;" target="cc" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>YesSequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>Flow_1pjrvj7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="HasEmailGateway" name="has email?" default="YesSequenceFlow2">
      <bpmn:incoming>NoSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>YesSequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>NoSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="YesSequenceFlow2" name="yes" sourceRef="HasEmailGateway" targetRef="SendEmailTask" />
    <bpmn:sequenceFlow id="NoSequenceFlow1" name="no" sourceRef="HasEmailGateway" targetRef="CallClientTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=email = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0pkzqho" sourceRef="CallClientTask" targetRef="Gateway_0wb6b1z" />
    <bpmn:sequenceFlow id="Flow_1d8pt6p" sourceRef="Gateway_0wb6b1z" targetRef="NotSuccededEndEvent" />
    <bpmn:userTask id="CallClientTask" name="Call Client">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="CallClientTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>NoSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_0pkzqho</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0wb6b1z">
      <bpmn:incoming>Flow_0pkzqho</bpmn:incoming>
      <bpmn:incoming>Flow_1pjrvj7</bpmn:incoming>
      <bpmn:outgoing>Flow_1d8pt6p</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SuccededEndEvent" name="succeded">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;succeeded&#34;" target="processStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>YesSequenceFlow1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="NotSuccededEndEvent" name="not succeded">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;notSucceeded&#34;" target="processStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1d8pt6p</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
