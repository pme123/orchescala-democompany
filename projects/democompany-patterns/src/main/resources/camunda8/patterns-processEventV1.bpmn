        <zeebe:ioMapping>
          <zeebe:output source="=&#34;succeeded&#34;" target="processStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>PostEventFlow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="StartFlow" sourceRef="StartEvent" targetRef="PostEventTask" />
    <bpmn:sequenceFlow id="PostEventFlow" sourceRef="PostEventTask" targetRef="SucceededEndEvent" />
  </bpmn:process>
