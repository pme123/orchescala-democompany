  <bpmn:process id="democompany-patterns-processEventV1" name="democompany-patterns-processEventV1" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Event">
      <bpmn:outgoing>StartFlow</bpmn:outgoing>
