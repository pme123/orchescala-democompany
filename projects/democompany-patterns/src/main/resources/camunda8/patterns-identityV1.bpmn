<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_patternsIdentityV1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.34.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="democompany-patterns-identityV1" name="democompany-patterns-identityV1" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>StartFlow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="InitProcessTask" name="Init Process">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="democompany-patterns-identityV1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;output-mocked&#34;" target="_handledErrors" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>StartFlow</bpmn:incoming>
      <bpmn:outgoing>InitProcessFlow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ApproveRequestUT" name="Antrag freigeben">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>InitProcessFlow</bpmn:incoming>
      <bpmn:outgoing>ApproveRequestFlow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="TakeOverIdentityEvent" name="Identität übernehmen">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=_identityCorrelation" target="_identityCorrelationBefore" />
          <zeebe:output source="=if _identityCorrelationOfActor = null then _identityCorrelation else _identityCorrelationOfActor" target="_identityCorrelation" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>ApproveRequestFlow</bpmn:incoming>
      <bpmn:outgoing>TakeOverIdentityFlow</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="CheckIdentityAsActorTask" name="Identität prüfen (übernommen)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="democompany-patterns-identityV1-CheckIdentity" />
        <zeebe:ioMapping>
          <zeebe:input source="=true" target="_servicesMocked" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>TakeOverIdentityFlow</bpmn:incoming>
      <bpmn:outgoing>CheckIdentityAsActorFlow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CloseRequestUT" name="Antrag abschliessen">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>CheckIdentityAsActorFlow</bpmn:incoming>
      <bpmn:outgoing>CloseRequestFlow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="ResetIdentityEvent" name="Identität zurücksetzen">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=_identityCorrelationBefore" target="_identityCorrelation" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>CloseRequestFlow</bpmn:incoming>
      <bpmn:outgoing>ResetIdentityFlow</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="CheckIdentityAsStarterTask" name="Identität prüfen (zurückgesetzt)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="democompany-patterns-identityV1-CheckIdentity" />
        <zeebe:ioMapping>
          <zeebe:input source="=true" target="_servicesMocked" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>ResetIdentityFlow</bpmn:incoming>
      <bpmn:outgoing>CheckIdentityAsStarterFlow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="SucceededEndEvent" name="succeeded">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;succeeded&#34;" target="processStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>CheckIdentityAsStarterFlow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="OutputMockedBoundary" attachedToRef="InitProcessTask">
      <bpmn:outgoing>OutputMockedBoundaryFlow</bpmn:outgoing>
      <bpmn:errorEventDefinition id="OutputMockedBoundaryDef" errorRef="OutputMockedError" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="OutputMockedThrow" name="output-mocked">
      <bpmn:incoming>OutputMockedBoundaryFlow</bpmn:incoming>
      <bpmn:linkEventDefinition id="OutputMockedThrowDef" name="output-mocked" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="OutputmockedEvent" name="output-mocked">
      <bpmn:outgoing>OutputmockedFlow</bpmn:outgoing>
      <bpmn:linkEventDefinition id="OutputmockedEventDef" name="output-mocked" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="OutputmockedEndEvent" name="output-mocked">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;output-mocked&#34;" target="processStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>OutputmockedFlow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="StartFlow" sourceRef="StartEvent" targetRef="InitProcessTask" />
    <bpmn:sequenceFlow id="InitProcessFlow" sourceRef="InitProcessTask" targetRef="ApproveRequestUT" />
    <bpmn:sequenceFlow id="ApproveRequestFlow" sourceRef="ApproveRequestUT" targetRef="TakeOverIdentityEvent" />
    <bpmn:sequenceFlow id="TakeOverIdentityFlow" sourceRef="TakeOverIdentityEvent" targetRef="CheckIdentityAsActorTask" />
    <bpmn:sequenceFlow id="CheckIdentityAsActorFlow" sourceRef="CheckIdentityAsActorTask" targetRef="CloseRequestUT" />
    <bpmn:sequenceFlow id="CloseRequestFlow" sourceRef="CloseRequestUT" targetRef="ResetIdentityEvent" />
    <bpmn:sequenceFlow id="ResetIdentityFlow" sourceRef="ResetIdentityEvent" targetRef="CheckIdentityAsStarterTask" />
    <bpmn:sequenceFlow id="CheckIdentityAsStarterFlow" sourceRef="CheckIdentityAsStarterTask" targetRef="SucceededEndEvent" />
    <bpmn:sequenceFlow id="OutputMockedBoundaryFlow" sourceRef="OutputMockedBoundary" targetRef="OutputMockedThrow" />
    <bpmn:sequenceFlow id="OutputmockedFlow" sourceRef="OutputmockedEvent" targetRef="OutputmockedEndEvent" />
  </bpmn:process>
  <bpmn:error id="OutputMockedError" name="output-mocked" errorCode="output-mocked" />
