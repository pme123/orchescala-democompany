<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_patternsStopWithErrorV1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.34.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:process id="democompany-patterns-stopWithErrorV1" name="democompany-patterns-stopWithErrorV1" isExecutable="true" camunda:historyTimeToLive="5">
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>StartFlow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="InitProcessTask" name="Init Process" camunda:type="external" camunda:topic="democompany-patterns-stopWithErrorV1">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="_handledErrors">output-mocked</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>StartFlow</bpmn:incoming>
      <bpmn:outgoing>InitProcessFlow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BlockedGateway" name="Kunde gesperrt?">
      <bpmn:incoming>InitProcessFlow</bpmn:incoming>
      <bpmn:outgoing>NotBlockedFlow</bpmn:outgoing>
      <bpmn:outgoing>BlockedFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="LimitGateway" name="Limit überschritten?">
      <bpmn:incoming>NotBlockedFlow</bpmn:incoming>
      <bpmn:outgoing>LimitOkFlow</bpmn:outgoing>
      <bpmn:outgoing>LimitExceededFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="LimitExceededEvent" name="Limit überschritten" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R1/PT0S</camunda:failedJobRetryTimeCycle>
        <camunda:inputOutput>
          <camunda:inputParameter name="_errorMessage">${"Limit von ".concat(customerName).concat(" überschritten.")}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">throw new IllegalArgumentException(String.valueOf(execution.getVariable("_errorMessage")))</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>LimitExceededFlow</bpmn:incoming>
      <bpmn:outgoing>LimitContinueFlow</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="SucceededEndEvent" name="succeeded">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;processStatus&#34;, &#34;succeeded&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>LimitOkFlow</bpmn:incoming>
      <bpmn:incoming>LimitContinueFlow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="StoppedEndEvent" name="Kunde gesperrt" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R1/PT0S</camunda:failedJobRetryTimeCycle>
        <camunda:inputOutput>
          <camunda:inputParameter name="_errorMessage">${"Kunde ".concat(customerName).concat(" ist gesperrt.")}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">throw new IllegalArgumentException(String.valueOf(execution.getVariable("_errorMessage")))</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>BlockedFlow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="OutputMockedBoundary" attachedToRef="InitProcessTask">
      <bpmn:outgoing>OutputMockedBoundaryFlow</bpmn:outgoing>
      <bpmn:errorEventDefinition id="OutputMockedBoundaryDef" errorRef="OutputMockedError" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="OutputMockedThrow" name="output-mocked">
      <bpmn:incoming>OutputMockedBoundaryFlow</bpmn:incoming>
      <bpmn:linkEventDefinition id="OutputMockedThrowDef" name="output-mocked" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="OutputmockedEvent" name="output-mocked">
      <bpmn:outgoing>OutputmockedFlow</bpmn:outgoing>
      <bpmn:linkEventDefinition id="OutputmockedEventDef" name="output-mocked" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="OutputmockedEndEvent" name="output-mocked">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;processStatus&#34;, &#34;output-mocked&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>OutputmockedFlow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="StartFlow" sourceRef="StartEvent" targetRef="InitProcessTask" />
    <bpmn:sequenceFlow id="InitProcessFlow" sourceRef="InitProcessTask" targetRef="BlockedGateway" />
    <bpmn:sequenceFlow id="NotBlockedFlow" name="nein" sourceRef="BlockedGateway" targetRef="LimitGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not blocked}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="LimitOkFlow" name="nein" sourceRef="LimitGateway" targetRef="SucceededEndEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not limitExceeded}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="LimitExceededFlow" name="ja" sourceRef="LimitGateway" targetRef="LimitExceededEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${limitExceeded}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="LimitContinueFlow" sourceRef="LimitExceededEvent" targetRef="SucceededEndEvent" />
    <bpmn:sequenceFlow id="BlockedFlow" name="ja" sourceRef="BlockedGateway" targetRef="StoppedEndEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${blocked}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="OutputMockedBoundaryFlow" sourceRef="OutputMockedBoundary" targetRef="OutputMockedThrow" />
    <bpmn:sequenceFlow id="OutputmockedFlow" sourceRef="OutputmockedEvent" targetRef="OutputmockedEndEvent" />
  </bpmn:process>
  <bpmn:error id="OutputMockedError" name="output-mocked" errorCode="output-mocked" />
