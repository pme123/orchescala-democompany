      ],
      "fields" : [
        {
          "name" : "subStatusKey",
          "type" : "String",
          "description" : "The Status Key for the sub-task.",
          "example" : "SubStatusKeyDocuments.`documents-prepared`.toString"
        },
        {
          "name" : "subStatusScore",
          "type" : "Option[Int]",
          "description" : "The score of the Sub Status. Only used for Graviton.",
          "example" : "Some(33)"
        },
        {
          "name" : "businessKey",
          "type" : "Option[String]",
          "description" : "The Business Key of the parent Process (needed for CAM Service URL).",
          "example" : "Some(\"cam-special-id\")"
        },
        {
          "name" : "receivingSystems",
          "type" : "ReceivingSystems",
          "description" : "A Comma separated List of the system the Status should be sent to. If you only want to send a Gamification action, use ${ReceivingSystem.ONLYGAMIFICATION}. Supported: ${ReceivingSystem.values.toSeq\n            .mkString(\", \")}",
          "descriptionExpr" : "s\"A Comma separated List of the system the Status should be sent to. If you only want to send a Gamification action, use ${ReceivingSystem.ONLYGAMIFICATION}. Supported: ${ReceivingSystem.values.toSeq .mkString(\", \")}\"",
          "example" : "ReceivingSystem.values.toSeq"
        },
        {
          "name" : "processDefinitionKey",
          "type" : "String",
          "description" : "The processDefinitionKey of the Parent Process",
          "example" : "\"myProcessDefinitionKey\""
        },
        {
          "name" : "processInstanceId",
          "type" : "ProcessInstanceId",
          "description" : "The processInstanceId of the Parent Process: C7 -> UUID (String), C8 -> processInstanceKey (Long).",
          "example" : "\"a42480f5-821e-11ef-9a07-0242ac120007\""
        },
        {
          "name" : "taskId",
          "type" : "Option[String :| ValidUUID]",
          "description" : "The taskId of the UserTask. Is set if the Event is for a UserTask (new pattern).",
          "example" : "Option(\"a7788e13-821e-11ef-9a07-0242ac120007\")"
        },
        {
          "name" : "taskDefinitionKey",
          "type" : "Option[String]",
          "description" : "The taskDefinitionKey of the UserTask. Is set if the Event is for a UserTask (new pattern - use Listener `valiant-bpmn:scripts/sendProcessEvent/taskListener.groovy`).\n\nThis can also be used for Call Activities (use Listener: `valiant-bpmn:scripts/sendProcessEvent/activityListener.groovy`), if they take longer and may be canceled for example.",
          "example" : "Some(\"KDCCheckTask\")"
        },
        {
          "name" : "responsibleUser",
          "type" : "Option[Long]",
          "description" : "Is set with the new pattern.",
          "example" : "Some(defaultResponsibleUser)"
        },
        {
          "name" : "state",
          "type" : "Option[CProcessState]",
          "description" : "This is the status of the process, in this context it is always `ACTIVE`, which is the default if not set.",
          "example" : "None"
        },
        {
          "name" : "identityLinks",
          "type" : "Option[Seq[IdentityLink]]",
          "description" : "Set in the new pattern the Camunda _IdentityLinks_ for the UserTask.",
          "example" : "None"
        },
        {
          "name" : "impersonateUserId",
          "type" : "Option[String]",
          "description" : "DEPRECATED: Use _identityCorrelation_ instead. The id of the user that started the escalation process. Used for impersonation in the process. Will be REMOVED in the future.",
          "example" : "None"
        },
        {
          "name" : "_identityCorrelation",
          "type" : "Option[IdentityCorrelation]",
          "description" : "PROVIDED by the Process.\nNeeded for the `username` if the `responsibleUser` is not set.\n - if `responsibleUser` is set -> `userKey`\n - if `username` starts with `$adUserPrefix` -> resolve user (`${GetConsultant.topicName}`)\n - otherwise -> `userKey` = `$defaultResponsibleUser` (KDC User)",
          "descriptionExpr" : "s\"\"\"PROVIDED by the Process.\n           |Needed for the `username` if the `responsibleUser` is not set.\n           | - if `responsibleUser` is set -> `userKey`\n           | - if `username` starts with `$adUserPrefix` -> resolve user (`${GetConsultant.topicName}`)\n           | - otherwise -> `userKey` = `$defaultResponsibleUser` (KDC User)\n           |\"\"\".stripMargin",
          "example" : "Some(IdentityCorrelation.example)"
        },
        {
          "name" : "inConfig",
          "type" : "Option[InConfig]",
          "default" : "None",
          "description" : "A way to override process configuration.\n\n**SHOULD NOT BE USED on Production!**"
        }
      ],
