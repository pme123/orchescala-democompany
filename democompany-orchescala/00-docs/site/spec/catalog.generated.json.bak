              "name" : "beilagenCount",
              "type" : "Int",
              "description" : "`docContents.customDocContents.Beilage1` - QR-Rechnung. Rule: Set if `isRenter` and `invoiceToRenter` or vice versa. If == 0, no Beilage. If > 1, it is plural."
            }
          ]
        },
        {
          "name" : "`QR-Rechnung`",
          "fields" : [
            {
              "name" : "betragFranken",
              "type" : "Option[BigDecimal]",
              "description" : "`docContents.customDocContents.BetragFranken` - `rentalObject.totalAmount`. Regel: wird nur befüllt, wenn es nur eine einzige Rate gibt (`rentalObject.rateCount = 1`)."
            }
          ]
        },
        {
          "name" : "NoCustomContent"
        }
      ]
    },
