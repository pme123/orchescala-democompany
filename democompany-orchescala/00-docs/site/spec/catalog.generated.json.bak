      "source" : "valiant-product/01-domain/src/main/scala/valiant/product/domain/loadPoas/v1/MergePoas.scala",
      "imports" : [
        "swisscom.fil.is.domain.ClientType",
        "valiant.fil.is.domain.accountAndPortfolio.v3.schema.Account",
        "valiant.fil.is.domain.address.v2.schema.Address",
        "valiant.fil.is.domain.address.v2.schema.Communication",
