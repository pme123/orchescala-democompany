    {
      "id" : "valiant.services.domain.camunda.v7.schema.ProcessInstanceModificationInstructionDto",
      "name" : "ProcessInstanceModificationInstructionDto",
      "pkg" : "valiant.services.domain.camunda.v7.schema",
      "kind" : "case",
      "importPath" : "valiant.services.domain.camunda.v7.schema.ProcessInstanceModificationInstructionDto",
      "source" : "valiant-services/01-domain/src/main/scala/valiant/services/domain/camunda/v7/schema/ProcessInstanceModificationInstructionDto.scala",
      "fields" : [
        {
          "name" : "variables",
          "type" : "Option[TriggerVariableValueDto]",
          "example" : "Some(TriggerVariableValueDto.example.Default0)"
        },
        {
          "name" : "activityId",
          "type" : "Option[String]",
          "description" : "Can be used with instructions of types `startTransition`. Specifies the sequence flow to start.",
          "example" : "Some(\"SomeDummyText\")"
        },
        {
          "name" : "transitionId",
          "type" : "Option[String]",
          "description" : "Can be used with instructions of types `startTransition`. Specifies the sequence flow to start.",
          "example" : "Some(\"SomeDummyText\")"
        },
        {
          "name" : "activityInstanceId",
          "type" : "Option[String]",
          "description" : "Can be used with instructions of type `cancel`. Specifies the activity instance to cancel.\nValid values are the activity instance IDs supplied by the [Get Activity Instance request](https://docs.camunda.org/manual/7.20/reference/rest/process-instance/get-activity-instances/).",
          "example" : "Some(\"SomeDummyText\")"
        },
        {
          "name" : "transitionInstanceId",
          "type" : "Option[String]",
          "description" : "Can be used with instructions of type `cancel`. Specifies the transition instance to cancel.\nValid values are the transition instance IDs supplied by the [Get Activity Instance request](https://docs.camunda.org/manual/7.20/reference/rest/process-instance/get-activity-instances/).",
          "example" : "Some(\"SomeDummyText\")"
        },
        {
          "name" : "ancestorActivityInstanceId",
          "type" : "Option[String]",
          "description" : "Can be used with instructions of type `startBeforeActivity`, `startAfterActivity`, and `startTransition`.\nValid values are the activity instance IDs supplied by the Get Activity Instance request.\nIf there are multiple parent activity instances of the targeted activity,\nthis specifies the ancestor scope in which hierarchy the activity/transition is to be instantiated.\n\nExample: When there are two instances of a subprocess and an activity contained in the subprocess is to be started,\nthis parameter allows to specifiy under which subprocess instance the activity should be started.",
          "example" : "Some(\"SomeDummyText\")"
        },
        {
          "name" : "cancelCurrentActiveActivityInstances",
          "type" : "Option[Boolean]",
          "description" : "Can be used with instructions of type cancel. Prevents the deletion of new created activity instances.",
          "example" : "Some(true)"
        }
      ]
    },
    {
      "id" : "valiant.services.domain.camunda.v7.schema.ProcessInstanceModificationInstructionDto.Type",
      "name" : "ProcessInstanceModificationInstructionDto.Type",
