          "description" : "Adjusted _ProductToOpen_.",
          "example" : "InitProductToOpen.example"
        },
        {
          "name" : "firstNameForDuplicateCheck",
          "type" : "String",
          "description" : "If there are more than one name, take only the first. Example: _Hans Peter_ -> _Hans_. Be aware that _Hans-Peter_ stays _Hans-Peter_.",
          "example" : "\"Pascal\""
        },
        {
          "name" : "age",
          "type" : "Int",
          "description" : "Calculates the age of the client.",
          "example" : "38"
        },
        {
          "name" : "hasNewAccounts",
          "type" : "Boolean",
          "description" : "Initialises the Process variable to _true_, if `productToOpen.newAccounts` is not empty.",
          "example" : "true"
        },
        {
          "name" : "reminderNotSent",
          "type" : "Boolean",
          "default" : "true",
          "description" : "Initialises the Process variable to _true_.",
          "example" : "true"
        },
        {
          "name" : "processCallOrigin",
          "type" : "ProcessCallOrigin",
          "description" : "Replaces _MobileApp_ -> _CAMMobile_ and _VPORTAL_ -> _CAMWeb_.",
          "example" : "ProcessCallOrigin.CAMMobile"
        },
        {
          "name" : "welcomeMessage",
          "type" : "String",
          "description" : "Initialises the process variable with welcome message text (VALIANT-01) sent to the Messenger service in the process, based on the client's language.",
          "example" : "\"Guten Tag\\nIhr Konto ist nun bereit. Viel Spass bei der Nutzung von Valiant Mobile Banking.\\n\""
        },
        {
          "name" : "processStatus",
          "type" : "CustomProcessStatus",
          "default" : "CustomProcessStatus.started",
          "description" : "Initialises the process variable with _${CustomProcessStatus.started}_.",
          "descriptionExpr" : "s\"Initialises the process variable with _${CustomProcessStatus.started}_.\"",
          "example" : "CustomProcessStatus.started"
        }
      ],
