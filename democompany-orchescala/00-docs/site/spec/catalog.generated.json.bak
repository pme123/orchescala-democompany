    {
      "id" : "valiant.fil.is.domain.address.v2.schema.Address",
      "name" : "Address",
      "pkg" : "valiant.fil.is.domain.address.v2.schema",
      "kind" : "case",
      "importPath" : "valiant.fil.is.domain.address.v2.schema.Address",
      "source" : "valiant-fil-is/01-domain/address/src/main/scala/valiant/fil/is/domain/address/v2/schema/Address.scala",
      "imports" : [
        "swisscom.fil.is.domain.*"
      ],
      "fields" : [
        {
          "name" : "addressType",
          "type" : "Int",
          "description" : "Address type;\n    - Format: int32",
          "example" : "11"
        },
        {
          "name" : "validAfter",
          "type" : "LocalDate",
          "description" : "Valid from (inclusive) (YYYY-MM-DD)\n    - Format: date\n\nThis is optional according to spec.",
          "example" : "LocalDate.parse(\"2007-07-11\")"
        },
        {
          "name" : "validUntil",
          "type" : "LocalDate",
          "description" : "Valid until (inclusive) (YYYY-MM-DD)\n    - Format: date\n\nThis is optional according to spec.",
          "example" : "LocalDate.parse(defaultValidUntilStr)"
        },
        {
          "name" : "recipientReference",
          "type" : "Option[String]",
          "description" : "Address line recipient reference",
          "example" : "None"
        },
        {
          "name" : "recipientReferenceAddition",
          "type" : "Option[String]",
          "description" : "Additional recipient reference",
          "example" : "None"
        },
        {
          "name" : "street",
          "type" : "Option[String]",
          "description" : "Street designation",
          "example" : "Some(\"Sägestrasse\")"
        },
        {
          "name" : "houseNumber",
          "type" : "Option[String]",
          "description" : "House number -> from streetNumber v1",
          "example" : "Some(\"22\")"
        },
        {
          "name" : "poBox",
          "type" : "Option[Int]",
          "description" : "Code for PO box notation. This attribute will only be used if program parameter KD_ADR/PF_AKT = 1. Otherwise, it will be ignored. Use attribute poBoxNotationAndNumber instead.;\n    - Format: int32",
          "example" : "None"
        },
        {
          "name" : "poBoxNo",
          "type" : "Option[String]",
          "description" : "PO box number. This attribute will only be used if program parameter KD_ADR/PF_AKT = 1. Otherwise, it will be ignored. Use attribute poBoxNotationAndNumber instead.",
          "example" : "None"
        },
        {
          "name" : "place",
          "type" : "Option[String]",
          "description" : "Designation of the place (excl. country and postcode)",
          "example" : "Some(\"Lenzburg\")"
        },
        {
          "name" : "postcode",
          "type" : "Option[String]",
          "description" : "Postcode - from zipCode v1",
          "example" : "Some(\"5600\")"
        },
        {
          "name" : "postcodeAddition",
          "type" : "Option[Int]",
          "description" : "Addition to postcode (Only loaded for addresses in Switzerland);\n    - Format: int32",
          "example" : "None"
        },
        {
          "name" : "region",
          "type" : "Option[Int]",
          "description" : "Region;\n    - Format: int32",
          "example" : "Some(1)"
        },
        {
          "name" : "canton",
          "type" : "Option[String]",
          "description" : "Canton",
          "example" : "Some(\"AG\")"
        },
        {
          "name" : "country",
          "type" : "Option[String]",
          "description" : "Country;\nThe country dialog code is provided/returned for the attribute 'country'.\nThis dialog code is an external representation of the country reference.\nFor self-defined codes like 'DE' or 'DE '(Germany='DE' / Bï¿½singen='DE '), the value may differ from the corresponding ISO country code (SN EN ISO 3166-1).",
          "example" : "Some(\"CH\")"
        },
        {
          "name" : "vatCountry",
          "type" : "Option[String]",
          "description" : "VAT country;\nThe country dialog code is provided/returned for the attribute 'vatCountry'.\nThis dialog code is an external representation of the country reference.\nFor self-defined codes like 'DE' or 'DE '(Germany='DE' / Bï¿½singen='DE '), the value may differ from the corresponding ISO country code (SN EN ISO 3166-1).",
          "example" : "Some(\"CH\")"
        },
        {
          "name" : "correspondenceLanguageMan",
          "type" : "Option[String]",
          "description" : "Language used by the application for correspondence ï¿½ correspondence language (ISO 639-1)",
          "example" : "Some(\"de\")"
        },
        {
          "name" : "correspondenceLanguageSys",
          "type" : "Option[String]",
          "description" : "Language used by the application for correspondence if no correspondence language has been set manually",
          "example" : "Some(\"de\")"
        },
        {
          "name" : "dispatchType",
          "type" : "Option[DispatchType]",
          "description" : "Dispatch type",
          "example" : "Some(DispatchType.APO)"
        },
        {
          "name" : "noAdvertising",
          "type" : "Option[Boolean]",
          "description" : "Is true if advertising is not desired",
          "example" : "Some(false)"
        },
        {
          "name" : "coAddressFlag",
          "type" : "Option[Boolean]",
          "description" : "Indicates whether the address is a c/o address. Is true if it is a c/o address. Not allowed for domicile addresses.",
          "example" : "Some(false)"
        },
        {
          "name" : "correspondenceRule",
          "type" : "Option[Boolean]",
          "description" : "Is true if the address is used for a correspondence rule",
          "example" : "Some(false)"
        },
        {
          "name" : "invalid",
          "type" : "Option[Boolean]",
          "description" : "Is true if the address is set to invalid because of the parameterisation",
          "example" : "Some(false)"
        },
        {
          "name" : "poBoxNotationAndNumber",
          "type" : "Option[String]",
          "description" : "PO box notation and number (e.g. 'Postfach 56889', 'PO box 56889'). This attribute will only be used if program parameter KD_ADR/PF_AKT <> 1. Otherwise, it will be ignored. Use attributes poBox and poBoxNo instead.",
          "example" : "None"
        },
        {
          "name" : "initiatorNamePaymentTransaction",
          "type" : "Option[String]",
          "description" : "This attribute contains the name of the initiator of a payment transaction (only used by address type 16).",
          "example" : "None"
        },
        {
          "name" : "isStreetNumberBeforeStreetName",
          "type" : "Option[Boolean]",
          "description" : "Indicates whether the street number is before or after the street name.",
          "example" : "None"
        },
        {
          "name" : "resourceVersionID",
          "type" : "Option[String]",
          "description" : "Etag for the Address",
          "example" : "Some(etagExample)"
        }
      ]
    },
