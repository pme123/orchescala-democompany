          "type" : "Option[ExecutionDto]",
          "example" : "None"
        },
        {
          "name" : "variables",
          "type" : "Option[CamundaVariables]",
          "description" : "This property is returned if the `variablesInResultEnabled` is set to `true`.\nContains a list of the process variables.",
          "example" : "None"
        }
      ]
    },
