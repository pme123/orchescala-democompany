          "name" : "contractDigitalAssetsDesired",
          "expression" : "= contractDigitalAssetsDesired",
          "description" : "Flag if you want _Vertragszusatz Digitale Vermögenswerte_. Default is `false`.",
          "variants" : [
            "Standard"
          ]
        },
        {
          "name" : "settlementAccounts",
          "expression" : "= settlementAccounts"
        },
        {
          "name" : "investmentObjective",
          "expression" : "= investmentObjective",
          "description" : "If the investmentProduct is 1, the investmentObjective is not needed. Otherwise it is required."
        },
        {
          "name" : "defaultPaymentRule",
          "expression" : "= defaultPaymentRule"
        },
        {
          "name" : "customDocContents",
          "expression" : "= customDocContents",
          "description" : "All needed content for generating your document that is not provided by the document-info DMN.\n\nIt has the following structure (the key is the _clientKey_, resp, the _clientKey_ of the Partner):\n```\n{\n  \"152341234\": {\n      \"customAttr1\": \"true\",\n      \"customAttr1\": \"true\",\n   },\n   \"34535656\": {\n      \"customAttr1\": \"true\",\n      \"customAttr1\": \"false\",\n   }\n}\n```"
        },
        {
          "name" : "selectedFonds",
          "expression" : "= selectedFonds",
          "variants" : [
            "Standard"
          ]
        },
        {
          "name" : "investmentAmount",
          "expression" : "= investmentAmount",
          "required" : true,
          "variants" : [
            "VermoegensVerwaltung"
          ]
        },
        {
          "name" : "payments",
          "expression" : "= payments",
          "variants" : [
            "VermoegensVerwaltung"
          ]
        },
        {
          "name" : "internalTransferPortfolioId",
          "expression" : "= internalTransferPortfolioId",
          "variants" : [
            "VermoegensVerwaltung"
          ]
        }
      ],
      "outputs" : [
        {
          "name" : "processStatus",
          "expression" : "= processStatus",
          "required" : true
        },
        {
          "name" : "validationErrors",
          "expression" : "= validationErrors",
          "variants" : [
            "NotValid"
          ]
        },
        {
          "name" : "eegDesired",
          "expression" : "= eegDesired",
          "description" : "Just for testing",
          "required" : true,
          "variants" : [
            "Opened"
          ]
        },
        {
          "name" : "responsibleUser",
          "expression" : "= responsibleUser",
          "description" : "Check for testing",
          "required" : true,
          "variants" : [
            "Opened"
          ]
        },
        {
          "name" : "callingProcessKeyDE",
          "expression" : "= callingProcessKeyDE",
          "description" : "Label of the calling Process in german.",
          "required" : true,
          "variants" : [
            "Opened"
          ]
        },
        {
          "name" : "callingProcessKeyFR",
          "expression" : "= callingProcessKeyFR",
          "description" : "Label of the calling Process in french.",
          "required" : true,
          "variants" : [
            "Opened"
          ]
        }
      ]
