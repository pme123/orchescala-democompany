      "id" : "valiant.fil.is.domain.card.v4.schema.Card",
      "name" : "Card",
      "pkg" : "valiant.fil.is.domain.card.v4.schema",
      "kind" : "case",
      "importPath" : "valiant.fil.is.domain.card.v4.schema.Card",
