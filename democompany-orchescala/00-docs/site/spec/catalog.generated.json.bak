        "valiant.fil.is.domain.pensionPlan.v1.GetPensionPlans",
        "valiant.fil.is.domain.pensionPlan.v1.schema.SecuritiesAllocation"
      ],
      "fields" : [
        {
          "name" : "privorEmailRecipients",
          "type" : "String",
          "default" : "privorEmailRecipients",
          "description" : "To test email, you can override this.",
          "example" : "privorEmailRecipients"
        },
        {
          "name" : "waitForCancel",
          "type" : "Boolean",
          "default" : "false",
          "description" : "To test cancel from other processes you need to set this flag.",
          "example" : "false"
        },
        {
          "name" : "ignoreCodesCache",
          "type" : "Boolean",
          "default" : "false",
          "description" : "A way to invalidate ignore the codes cache (set to true). Default is `false`.",
          "example" : "false"
        },
        {
          "name" : "timerStartEscalation",
          "type" : "Iso8601Duration",
          "default" : "\"P1D\"",
          "description" : "Time to wait, before the escalation process is started in ISO 8601 format, e.g. P1D. Default is 1 day.",
          "example" : "\"P1D\""
        },
        {
          "name" : "timerEscalationInform",
          "type" : "Iso8601Duration",
          "default" : "defaultTimerEscalationInform",
          "description" : "Time to wait, before start the escalation in ISO 8601 format, e.g. P21D - default 21 days",
          "example" : "defaultTimerEscalationInform"
        },
        {
          "name" : "timerEscalationCancel",
          "type" : "Iso8601Duration",
          "default" : "defaultTimerEscalationCancel",
          "description" : "Time to wait, before cancel the process after escalation has started in ISO 8601 format, e.g. P21D - default 7 days",
          "example" : "defaultTimerEscalationCancel"
        },
        {
          "name" : "timerEscalationMessenger",
          "type" : "Iso8601Duration",
          "default" : "defaultTimerEscalationMessenger",
          "description" : "Time to wait, before sending escalation via messenger in ISO 8601 format, e.g. P21D - default 2 days",
          "example" : "defaultTimerEscalationMessenger"
        },
        {
          "name" : "timerInformKube",
          "type" : "Iso8601Duration",
          "default" : "\"PT1M\"",
          "description" : "Time to wait, before Kube gets an information per email, e.g. PT1m - default 1 minute",
          "example" : "\"PT1M\""
        },
        {
          "name" : "timerSendProcessEvent",
          "type" : "Iso8601Duration",
          "default" : "\"PT5S\"",
          "description" : "How long to wait before _${SendProcessEvent.processName}_ - default is `PT5S` - for testing use `PT0S`",
          "descriptionExpr" : "s\"How long to wait before _${SendProcessEvent.processName}_ - default is `PT5S` - for testing use `PT0S`\"",
          "example" : "\"PT5S\""
        },
        {
          "name" : "timerRetirementCustodyAccountKey",
          "type" : "Iso8601Duration",
          "default" : "\"PT20S\"",
          "description" : "Wait for retirement custody account - default 20 seconds (PT20S) - for testing use `PT0S`",
          "example" : "\"PT20S\""
        },
        {
          "name" : "timerWaitForCancelFinished",
          "type" : "Iso8601Duration",
          "default" : "defaultTimerWaitForCancelFinished",
          "description" : "Time to wait before check again if canceling the printing is finished.",
          "example" : "defaultTimerWaitForCancelFinished"
        },
        {
          "name" : "waitForRetirementCustodyAccountKeyMax",
          "type" : "Int",
          "default" : "10",
          "description" : "Max number of attempts the process should check if the retirement custody account is created.\nAfter so many attempts, the process will throw an error: `Retirement custody account not created after 10 attempts`.",
          "example" : "10"
        },
        {
          "name" : "waitForCancelDocsMax",
          "type" : "Int",
          "default" : "100",
          "description" : "Max number of attempts the process should check if the Documents are canceled. After so many attempts, the process will continue as if the Documents are canceled.",
          "example" : "100"
        },
        {
          "name" : "waitForDepotOpening",
          "type" : "Iso8601Duration",
          "default" : "\"PT20S\"",
          "description" : "Wait for depot opening - default 20 seconds (PT20S) - for testing use `PT0S`",
          "example" : "\"PT20S\""
        },
        {
          "name" : "unlockQMSRole",
