      "imports" : [
        "swisscom.fil.is.domain.*"
      ],
      "fields" : [
        {
          "name" : "level",
          "type" : "Level",
          "description" : "Validity range of the blocking rule. The Level determines the level at which the blocking rule has an impact. The three levels Client, Portfolio and Account exist. The Client level has a global impact for the entire client, the Portfolio level affects all accounts of the portfolio, and the Account level only affects the corresponding account.",
          "example" : "Level.Client"
        },
        {
          "name" : "validAfter",
          "type" : "Option[LocalDate]",
          "description" : "validAfterDescr",
          "descriptionExpr" : "validAfterDescr",
          "example" : "Some(LocalDate.now().minusDays(1))"
        },
        {
          "name" : "validUntil",
          "type" : "Option[LocalDate]",
          "description" : "validUntilDescr",
          "descriptionExpr" : "validUntilDescr",
          "example" : "Some(defaultValidUntil)"
        },
        {
          "name" : "blockingCode",
          "type" : "Int",
          "description" : "Type of block",
          "example" : "22"
        },
        {
          "name" : "levelKey",
          "type" : "Option[Long]",
          "description" : "Technical sequence number of the client, portfolio or account. LevelKey contains the key to the respective object of the level. If a blocking rule has an impact at Client level, the LevelKey has a client sequence number; if it has an impact at Portfolio level, the LevelKey contains an account group sequence number; and if it has an impact at Account level, it contains an account sequence number.",
          "example" : "None"
        },
        {
          "name" : "initiatorKey",
          "type" : "Option[Long]",
          "description" : "Technical sequence number of the bank employee who initiated the blocking",
          "example" : "None"
        },
        {
          "name" : "blockingAmount",
          "type" : "Option[FilBlockingAmount]",
          "description" : "Amount value with currency",
          "example" : "Some(FilBlockingAmount.example)"
        },
        {
          "name" : "comment",
          "type" : "Option[String]",
          "description" : "Comment regarding blocking rule for internal bank use",
          "example" : "None"
        }
      ]
    },
