    {
      "id" : "swisscom.fil.is.domain.dispatchRules.v1.PostDispatchRule.In",
      "name" : "PostDispatchRule.In",
      "pkg" : "swisscom.fil.is.domain.dispatchRules.v1",
      "kind" : "case",
      "owner" : "PostDispatchRule",
      "importPath" : "swisscom.fil.is.domain.dispatchRules.v1.PostDispatchRule",
      "source" : "swisscom-fil-is/01-domain/dispatchRules/src/main/scala/swisscom/fil/is/domain/dispatchRules/v1/PostDispatchRule.scala",
      "imports" : [
        "swisscom.fil.is.domain.dispatchRules.v1.schema.*"
      ],
      "fields" : [
        {
          "name" : "clientKey",
          "type" : "Long",
          "description" : "Technical key of the client",
          "example" : "defaultClientKey"
        },
        {
          "name" : "ruleScope",
          "type" : "Option[DispatchRuleModifiable]",
          "description" : "Describes the area of validity of a dispatch rule (client, portfolio or account)",
          "example" : "Some(DispatchRuleModifiable.example)"
        },
        {
          "name" : "comment",
          "type" : "Option[String]",
          "description" : "Comment regarding dispatch rule for bank-internal use",
          "example" : "None"
        },
        {
          "name" : "validAfter",
          "type" : "Option[LocalDate]",
          "description" : "Time at which the dispatch rule starts (excl.)",
          "example" : "Some(defaultValidAfter)"
        },
        {
          "name" : "validUntil",
          "type" : "Option[LocalDate]",
          "description" : "Time at which the dispatch rule ends (incl.)",
          "example" : "Some(defaultValidUntil)"
        },
        {
          "name" : "dispatchAddresses",
          "type" : "Option[Seq[DispatchRuleDetail]]",
          "description" : "The dispatch addresses with the associated document groupings",
          "example" : "Some(Seq(DispatchRuleDetail.example))"
        }
      ],
      "topicName" : "swisscom-fil-is-dispatchRulesV1.PostDispatchRule",
      "ownerDescr" : "Creation of a dispatch rule with the associated dispatch addresses.\nThe compilation of document groupings needs to represent the complete new set.\nPlease note that the unambiguousness only needs to be guaranteed across data records with the value 'true' for the attribute ORIGINAL.\nElements of document groupings may be repeated any number of times for dispatch addresses with the value false in the attribute ORIGINAL and must be unique for each data record.\n\nThe document grouping 9999 is an exception. This can only be used for the dispatch address with the value 'true' for the attribute ORIGINAL and the value 11 for the attribute DISPATCHADDRESSKEY.\nThis is the only document group that is allowed for this data record. This document group marks the default dispatch address.\nThere has to be a dispatch address with DISPATCHADDRESSKEY = 11 at all times.\n\nEvery document group that isn't explicitly assigned to a separate dispatch address with the value 'true' for the attribute ORIGINAL gets allocated to the default record.\n\nTo create a dispatch address for scopeLevel 'Contract', the FIL 22.2 must be used.\n\nSample request:\nPOST /banks/949/clients/123456789/dispatchrules"
    },
    {
      "id" : "swisscom.fil.is.domain.dispatchRules.v1.PostDispatchRule.Out",
      "name" : "PostDispatchRule.Out",
      "pkg" : "swisscom.fil.is.domain.dispatchRules.v1",
      "kind" : "case",
      "owner" : "PostDispatchRule",
      "importPath" : "swisscom.fil.is.domain.dispatchRules.v1.PostDispatchRule",
      "source" : "swisscom-fil-is/01-domain/dispatchRules/src/main/scala/swisscom/fil/is/domain/dispatchRules/v1/PostDispatchRule.scala",
      "imports" : [
        "swisscom.fil.is.domain.dispatchRules.v1.schema.*"
      ],
      "fields" : [
        {
          "name" : "resourceUri",
          "type" : "String",
          "description" : "URI of the created resource",
          "example" : "locationExample"
        },
        {
          "name" : "key",
          "type" : "Long",
          "description" : "Technical key of the created dispatch rule",
          "example" : "defaultDispatchRuleKey"
        }
      ],
      "topicName" : "swisscom-fil-is-dispatchRulesV1.PostDispatchRule",
      "ownerDescr" : "Creation of a dispatch rule with the associated dispatch addresses.\nThe compilation of document groupings needs to represent the complete new set.\nPlease note that the unambiguousness only needs to be guaranteed across data records with the value 'true' for the attribute ORIGINAL.\nElements of document groupings may be repeated any number of times for dispatch addresses with the value false in the attribute ORIGINAL and must be unique for each data record.\n\nThe document grouping 9999 is an exception. This can only be used for the dispatch address with the value 'true' for the attribute ORIGINAL and the value 11 for the attribute DISPATCHADDRESSKEY.\nThis is the only document group that is allowed for this data record. This document group marks the default dispatch address.\nThere has to be a dispatch address with DISPATCHADDRESSKEY = 11 at all times.\n\nEvery document group that isn't explicitly assigned to a separate dispatch address with the value 'true' for the attribute ORIGINAL gets allocated to the default record.\n\nTo create a dispatch address for scopeLevel 'Contract', the FIL 22.2 must be used.\n\nSample request:\nPOST /banks/949/clients/123456789/dispatchrules"
    },
    {
      "id" : "swisscom.fil.is.domain.dispatchRules.v1.PostDispatchRule.ServiceIn",
      "name" : "PostDispatchRule.ServiceIn",
