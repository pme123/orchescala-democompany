        "valiant.fil.is.domain.poa.v3.schema.PowerOfAttorney"
      ],
      "fields" : [
        {
          "name" : "isGivenPoa",
          "type" : "Boolean"
        },
        {
          "name" : "accountAssignedKey",
          "type" : "Option[Long]"
        },
        {
          "name" : "assignmentClient",
          "type" : "Option[AssignmentClientExtendedV2]"
        }
      ],
      "topicName" : "valiant-product-loadPoasV1-DecideIsGivenPoa",
      "dsl" : "CustomTask",
      "ownerDescr" : "Determines whether the current POA is a \"given POA\" and extracts accountAssignedKey and the first assignment client.\n\nPort of Groovy script that was formerly used as `isGivenPoa` output parameter on \"Get Details of Poa\".\n\nRules (as in valiant-vollmacht-ebanking):\n - poaStatus in {10, 50, 90}\n - and (\n     (poaType == 6026 and clientKey == assignmentClient.clientKey) OR\n     (poaType == 102  and clientKey != assignmentClient.clientKey)\n   )\n - requires assignmentClientsV2 non-empty, otherwise false\nAlso sets:\n - accountAssignedKey = powerOfAttorneyDetail.accountAssignedKey\n - assignmentClient   = first assignment client (if present)"
    },
