{
  "version" : 1,
  "services" : [
    {
      "id" : "swisscom-fil-is-clientV1.GetClientsClientKey",
      "name" : "GetClientsClientKey",
      "group" : "Swisscom FIL IS",
      "description" : "Delivers the data for a client master record.",
      "topic" : "swisscom-fil-is-clientV1.GetClientsClientKey",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "Technical sequence number of the client",
          "required" : true
        }
      ],
      "outputs" : [
        {
          "name" : "clientType",
          "expression" : "= clientType",
          "required" : true
        },
        {
          "name" : "master",
          "expression" : "= master",
          "description" : "See also _MasterCreate_ and _MasterUpdate_",
          "required" : true
        },
        {
          "name" : "supplementCompaniesAndOther",
          "expression" : "= supplementCompaniesAndOther",
          "description" : "This object can be used for Create, Read and Update",
          "required" : true,
          "variants" : [
            "companiesAndOther"
          ]
        },
        {
          "name" : "etag",
          "expression" : "= etag",
          "description" : "The 'etag' Header Field of the FIL Response. Needed for the PUT. Action will only be executed if resource version (from ETag) matches server version.",
          "required" : true
        },
        {
          "name" : "person",
          "expression" : "= person",
          "required" : true,
          "variants" : [
            "privateIndividual",
            "severalPrivateIndividuals"
          ]
        },
        {
          "name" : "personPartner",
          "expression" : "= personPartner",
          "required" : true,
          "variants" : [
            "severalPrivateIndividuals"
          ]
        }
      ]
    },
    {
      "id" : "swisscom-fil-is-clientV1.PostClientIdentifications",
      "name" : "PostClientIdentifications",
      "group" : "Swisscom FIL IS",
      "description" : "Reserves a new client identification in Finnova **without** opening a client.",
      "topic" : "swisscom-fil-is-clientV1.PostClientIdentifications",
      "kind" : "service",
      "inputs" : [
      ],
      "outputs" : [
        {
          "name" : "reservation",
          "expression" : "= reservation",
          "required" : true
        },
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "Technical client key of the client",
          "required" : true
        },
        {
          "name" : "editClientNumber",
          "expression" : "= editClientNumber",
          "description" : "External representation of the client number",
          "required" : true
        },
        {
          "name" : "transactionId",
          "expression" : "= transactionId",
          "description" : "Needed for the Request-Id Header to create the Customer (clientadministration.api.v1.put)\n\nNot in the FIL documentation. Taken from the header `X-Finnova-Transaction-Id`.",
          "required" : true
        }
      ]
    },
    {
      "id" : "swisscom-fil-is-clientV1.PostClients",
      "name" : "PostClients",
      "group" : "Swisscom FIL IS",
      "description" : "Opening of a new client master record **without** prior reservation of a client identification.",
      "topic" : "swisscom-fil-is-clientV1.PostClients",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "useCase",
          "expression" : "= useCase",
          "required" : true
        },
        {
          "name" : "master",
          "expression" : "= master",
          "description" : "Most fields of _MasterCreate_ - only _advisor_ as extra field.",
          "required" : true
        },
        {
          "name" : "domicileAddress",
          "expression" : "= domicileAddress",
          "description" : "Address data for the domicile address when opening a client. Other addresses can be managed via the FIL service AddressAdministration.",
          "required" : true
        },
        {
          "name" : "supplementCompaniesAndOther",
          "expression" : "= supplementCompaniesAndOther",
          "description" : "This object can be used for Create, Read and Update",
          "required" : true,
          "variants" : [
            "CreateCompaniesAndOther"
          ]
        },
        {
          "name" : "person",
          "expression" : "= person",
          "required" : true,
          "variants" : [
            "CreatePrivateIndividual",
            "CreateSeveralPrivateIndividuals"
          ]
        },
        {
          "name" : "personPartner",
          "expression" : "= personPartner",
          "required" : true,
          "variants" : [
            "CreateSeveralPrivateIndividuals"
          ]
        }
      ],
      "outputs" : [
        {
          "name" : "resourceUri",
          "expression" : "= resourceUri",
          "description" : "URI of the created resource",
          "required" : true
        },
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "The _clientKey_ is only set if the client is created (201).\n\n- There is no ClientKey if it is a multiple request. So it is taken from the resourceUri (e.g. /../clients/{clientKey}).",
          "required" : true
        }
      ]
    },
    {
      "id" : "swisscom-fil-is-clientV1.PutClientsClientKey",
      "name" : "PutClientsClientKey",
      "group" : "Swisscom FIL IS",
      "description" : "Opening of a new client master record **with** prior reservation of the client identification or modification of an existing client master record.",
      "topic" : "swisscom-fil-is-clientV1.PutClientsClientKey",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "Technical client key of the client",
          "required" : true
        },
        {
          "name" : "transactionId",
          "expression" : "= transactionId",
          "description" : "Needed to create a Client after a Reservation. See _clientadministration.reservation.api.v1.post_. If not provided, it will be generated for you.",
          "variants" : [
            "CreateWithResCompaniesAndOther",
            "CreateWithResPrivateIndividual",
            "CreateWithResSeveralPrivateIndividuals"
          ]
        },
        {
          "name" : "master",
          "expression" : "= master",
          "description" : "See _MasterCreate_.",
          "required" : true
        },
        {
          "name" : "domicileAddress",
          "expression" : "= domicileAddress",
          "description" : "See _DomicileAddress_.",
          "required" : true,
          "variants" : [
            "CreateWithResCompaniesAndOther",
            "CreateWithResPrivateIndividual",
            "CreateWithResSeveralPrivateIndividuals"
          ]
        },
        {
          "name" : "supplementCompaniesAndOther",
          "expression" : "= supplementCompaniesAndOther",
          "description" : "See _SupplementCompany_.",
          "required" : true,
          "variants" : [
            "CreateWithResCompaniesAndOther",
            "UpdateCompaniesAndOther"
          ]
        },
        {
          "name" : "clientType",
          "expression" : "= clientType",
          "description" : "If you have the clientType of the _swisscom-fil-is-clientV1.GetClientsClientKey_, you can provide it here instead of the _useCase_."
        },
        {
          "name" : "isUpdate",
          "expression" : "= isUpdate",
          "description" : "Is this a Create or an Update? Default is _true_."
        },
        {
          "name" : "useCase",
          "expression" : "= useCase",
          "description" : "Automatically set by the specific case.",
          "required" : true
        },
        {
          "name" : "person",
          "expression" : "= person",
          "description" : "See _PersonCreateUpdate_.",
          "required" : true,
          "variants" : [
            "CreateWithResPrivateIndividual",
            "CreateWithResSeveralPrivateIndividuals",
            "UpdatePrivateIndividual",
            "UpdateSeveralPrivateIndividuals"
          ]
        },
        {
          "name" : "personPartner",
          "expression" : "= personPartner",
          "description" : "Person data of the partner. See _PersonCreateUpdate_.",
          "required" : true,
          "variants" : [
            "CreateWithResSeveralPrivateIndividuals",
            "UpdateSeveralPrivateIndividuals"
          ]
        },
        {
          "name" : "etag",
          "expression" : "= etag",
          "description" : "Needed to update a Client.\n\nThe 'etag' Header Field of the FIL Response. Needed for the PUT. Action will only be executed if resource version (from ETag) matches server version.",
          "required" : true,
          "variants" : [
            "UpdateCompaniesAndOther",
            "UpdatePrivateIndividual",
            "UpdateSeveralPrivateIndividuals"
          ]
        }
      ],
      "outputs" : [
        {
          "name" : "person",
          "expression" : "= person",
          "description" : "The person of the client has a name or firstName that is too long, this is adjusted (name, firstName, officialFirstName, officialLastName)."
        },
        {
          "name" : "personPartner",
          "expression" : "= personPartner",
          "description" : "The personPartner of the client has a name or firstName that is too long, this is adjusted (name, firstName, officialFirstName, officialLastName)."
        },
        {
          "name" : "resourceUri",
          "expression" : "= resourceUri",
          "description" : "URI of the created resource"
        },
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "- With a PUT the clientKey is needed in the input - either a reserved ClientKey - or an existing ClientKey.",
          "required" : true
        }
      ]
    },
    {
      "id" : "swisscom-fil-is-clientV1.UpdateClientsClientKey",
      "name" : "UpdateClientsClientKey",
