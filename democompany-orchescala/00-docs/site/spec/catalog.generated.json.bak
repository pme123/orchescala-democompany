      ],
      "values" : [
        "created",
        "updated",
        "skipped"
      ],
      "processName" : "valiant-bpmn-contract-createUpdate",
      "dsl" : "Process",
      "ownerDescr" : "Create or Update a UpdateContract that is not yet in the right Status.\n- _update_: The _existingContractKey_ is set and the _existingContractStatus_ is NOT _skipped_ or _cancelled_.\n- _create_: The _existingContractKey_ is NOT set or the _existingContractStatus_ is _cancelled_ but NOT  _skipped_.\n- _skipped_: The _existingContractKey_ is on the _skipStatuses_ List (default is `[90]`)."
    },
    {
      "id" : "valiant.bpmn.domain.contractCreateUpdate.v1.ContractCreateUpdate.In",
      "name" : "ContractCreateUpdate.In",
      "pkg" : "valiant.bpmn.domain.contractCreateUpdate.v1",
      "kind" : "case",
      "owner" : "ContractCreateUpdate",
      "importPath" : "valiant.bpmn.domain.contractCreateUpdate.v1.ContractCreateUpdate",
      "source" : "valiant-bpmn/01-domain/src/main/scala/valiant/bpmn/domain/contractCreateUpdate/v1/ContractCreateUpdate.scala",
      "imports" : [
        "valiant.fil.is.domain.contract.v3.schema.Contract"
      ],
      "fields" : [
        {
          "name" : "clientKey",
          "type" : "Long",
          "description" : "clientKeyDescr",
          "descriptionExpr" : "clientKeyDescr",
          "example" : "defaultClientKey"
        },
        {
          "name" : "contractKey",
          "type" : "Option[Long]",
          "description" : "Technical key of the contract - only set for an update",
          "example" : "Some(defaultContractKey)"
        },
        {
          "name" : "existingContractStatus",
          "type" : "Option[Int]",
          "description" : "Status code of the existing contract [integer ($int32)  maximum: 99  minimum: 1].\n\nThis is taken to check if it can be skipped or must be created -> Status `99` (cancelled).\nIf not set, it will be taken from `contract.contractStatus`.",
          "example" : "None"
        },
        {
          "name" : "contract",
          "type" : "Option[UpdateContract]",
          "description" : "The UpdateContract you want to be updated or created.\nThe only difference to _valiant.fil.is.domain.contract.v3.schema.Contract_ is the optional _contractKey_.\nIf you only need the _contractStatus_ and the _contractType_ you can use these attributes instead (_newContractStatus_).",
          "example" : "Some(UpdateContract.example.copy(contractStatus = 80, validUntil = Some(\"2023-03-22\")))"
        },
        {
          "name" : "contractType",
          "type" : "Option[Int]",
          "description" : "Code of the contract / this must not change between existing- and new UpdateContract. [integer ($int32)  maximum: 9999  minimum: 1].\n\nRequired if you NOT provide the `contract.contractType`.",
          "example" : "None"
        },
        {
          "name" : "newContractStatus",
          "type" : "Option[Int]",
          "description" : "Status code of the new contract [integer ($int32)  maximum: 99  minimum: 1].\nIf not set, `contract.contractStatus` is required and will be taken.",
          "example" : "Some(90)"
        },
        {
          "name" : "skippedStatuses",
          "type" : "Option[Seq[Int]]",
          "description" : "Skipped _contractStatuses_.\n\nExample: `[80, 90]`\n\nDefault: `[$newContractStatus]` or `[90]` if `newContractStatus` is also not set.",
          "example" : "Some(Seq(90))"
        },
        {
          "name" : "inConfig",
          "type" : "Option[InConfig]",
          "default" : "None",
          "description" : "A way to override process configuration.\n\n**SHOULD NOT BE USED on Production!**"
        }
      ],
      "processName" : "valiant-bpmn-contract-createUpdate",
      "dsl" : "Process",
      "ownerDescr" : "Create or Update a UpdateContract that is not yet in the right Status.\n- _update_: The _existingContractKey_ is set and the _existingContractStatus_ is NOT _skipped_ or _cancelled_.\n- _create_: The _existingContractKey_ is NOT set or the _existingContractStatus_ is _cancelled_ but NOT  _skipped_.\n- _skipped_: The _existingContractKey_ is on the _skipStatuses_ List (default is `[90]`)."
    },
    {
