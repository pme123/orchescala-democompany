        "valiant.bpmn.domain.defaultTimerEscalationInform",
        "valiant.bpmn.domain.defaultTimerEscalationMessenger",
        "valiant.depot.domain.openPensionAccount3a.v1.schema.NewPensionProduct",
        "valiant.depot.domain.privorEmailRecipients",
        "valiant.documents.domain.printDocument.v1.schema.CustomDocContents",
        "swisscom.fil.is.domain.defaultValidUntil",
