          "expression" : "= contractType",
          "description" : "Code of the contract / this must not change between existing- and new UpdateContract. [integer ($int32)  maximum: 9999  minimum: 1].\n\n Default is 220. To allow to check multiple contractTypes you can send them like this `220,6080` - **Be Aware that the first one is taken for the update**"
        },
        {
          "name" : "contractStatus",
          "expression" : "= contractStatus",
          "description" : "Status code of the contract [integer ($int32)  maximum: 99  minimum: 1].\n\n Default is 90."
        },
        {
          "name" : "contractStatusPartner",
          "expression" : "= contractStatusPartner",
