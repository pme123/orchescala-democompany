      ],
      "fields" : [
        {
          "name" : "contractType",
          "type" : "Int",
          "description" : "Code of the contract [integer ($int32)  maximum: 9999  minimum: 1]",
          "example" : "117"
        },
        {
          "name" : "contractStatus",
          "type" : "Int",
          "description" : "Status code of the contract [integer ($int32)  maximum: 99  minimum: 1]",
          "example" : "90"
        },
        {
          "name" : "contractId",
          "type" : "Option[String]",
          "description" : "Bank-internal identification of the contract [Constraints: maxLength: 10]",
          "example" : "Some(\"VT0000334\")"
        },
        {
          "name" : "validFrom",
          "type" : "Option[LocalDate]",
          "description" : "Contract 'Valid from' [date (inclusive, YYYY-MM-DD) Mandatory field  for status 'Valid']",
          "example" : "Some(LocalDate.parse(\"2021-04-28\"))"
        },
        {
          "name" : "validUntil",
          "type" : "Option[LocalDate]",
          "description" : "Contract 'Valid until' [date (inclusive, YYYY-MM-DD)]",
          "example" : "Some(LocalDate.parse(\"2029-04-28\"))"
        },
        {
          "name" : "printingDate",
          "type" : "Option[LocalDate]",
          "description" : "Printing date of this contract [date YYYY-MM-DD]",
          "example" : "Some(LocalDate.parse(\"2021-04-28\"))"
        },
        {
          "name" : "approvalDate",
          "type" : "Option[LocalDate]",
          "description" : "Date on which bank authorities acknowledged or approved contract [date YYYY-MM-DD]",
          "example" : "Some(LocalDate.parse(\"2021-04-28\"))"
        },
        {
          "name" : "signatureDate",
          "type" : "Option[LocalDate]",
          "description" : "Date of the contract signature according to Place and date [date YYYY-MM-DD]",
          "example" : "Some(LocalDate.parse(\"2021-04-28\"))"
        },
        {
          "name" : "portfolioAssignedKey",
          "type" : "Option[Long]",
          "description" : "Technical portfolio number that is required -  if the contract refers to this portfolio. If nothing is delivered, the default portfolio '00' is used. [integer ($int64)  maximum: 99999999999999  minimum: 1]",
          "example" : "None"
        },
        {
          "name" : "accountAssignedKey",
          "type" : "Option[Long]",
          "description" : "Technical account number that is required -  if the contract refers to this account. [integer ($int64)  maximum: 1e+22  minimum: 1]",
          "example" : "None"
        },
        {
          "name" : "comment",
          "type" : "Option[String]",
          "description" : "Free text entry of comments about this contract [maxLength: 500]",
          "example" : "Some(\"Well this is a cool contract;).\")"
        },
        {
          "name" : "terminationRule",
          "type" : "Option[Int]",
          "description" : "Rule code of contract termination.If no value is delivered, the default value applies in accordance with contract type [integer ($int32)  maximum: 9999  minimum: 1]",
          "example" : "None"
        },
        {
          "name" : "storageLocation",
          "type" : "Option[String]",
          "description" : "Code of the document storage location. If no value is delivered, the default value according to contract type applies [maxLength : 4]",
          "example" : "None"
        },
        {
          "name" : "readOnly",
          "type" : "Option[Boolean]",
          "description" : "The contract can only be accessed in read-only mode. (true/false)",
          "example" : "None"
        },
        {
          "name" : "edocuments",
          "type" : "Option[Boolean]",
          "description" : "Accounts of a contract opened in the future receive electronic documents via e-banking as the dispatch type by default (true/false)",
          "example" : "Some(false)"
        },
        {
          "name" : "eBillId",
          "type" : "Option[String]",
          "description" : "Paynet ID of the contract holder of eBills in the SIX Paynet portal.",
          "example" : "None"
        }
      ]
    },
