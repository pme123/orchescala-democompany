    {
      "id" : "valiant.services.domain.camunda.v7.schema.StartProcessInstanceDto",
      "name" : "StartProcessInstanceDto",
      "pkg" : "valiant.services.domain.camunda.v7.schema",
      "kind" : "case",
      "importPath" : "valiant.services.domain.camunda.v7.schema.StartProcessInstanceDto",
      "source" : "valiant-services/01-domain/src/main/scala/valiant/services/domain/camunda/v7/schema/StartProcessInstanceDto.scala",
      "fields" : [
        {
          "name" : "businessKey",
          "type" : "Option[String]",
          "description" : "The business key of the process instance.",
          "example" : "Some(\"myBusinessKey\")"
        },
        {
          "name" : "variables",
          "type" : "Option[CamundaVariables]",
          "example" : "None"
        },
        {
          "name" : "caseInstanceId",
          "type" : "Option[String]",
          "description" : "The case instance id the process instance is to be initialized with.",
          "example" : "Some(\"SomeDummyText\")"
        },
        {
          "name" : "startInstructions",
          "type" : "Option[Seq[ProcessInstanceModificationInstructionDto]]",
          "description" : "**Optional**. A JSON array of instructions that specify which activities to start the process instance at.\nIf this property is omitted, the process instance starts at its default blank start event.",
          "example" : "Some(Seq(ProcessInstanceModificationInstructionDto.example))"
        },
        {
          "name" : "skipCustomListeners",
          "type" : "Option[Boolean]",
          "description" : "Skip execution listener invocation for activities that are started or ended as part of this request.\n**Note**: This option is currently only respected when start instructions are submitted\nvia the `startInstructions` property.",
          "example" : "Some(true)"
        },
        {
          "name" : "skipIoMappings",
          "type" : "Option[Boolean]",
          "description" : "Skip execution of\n[input/output variable mappings](https://docs.camunda.org/manual/7.20/user-guide/process-engine/variables/#input-output-variable-mapping)\nfor activities that are started or ended as part of this request.\n**Note**: This option is currently only respected when start instructions are submitted\nvia the `startInstructions` property.",
          "example" : "Some(true)"
        },
        {
          "name" : "withVariablesInReturn",
          "type" : "Option[Boolean]",
          "description" : "Indicates if the variables, which was used by the process instance during execution, should be returned.\nDefault value: `false`",
          "example" : "Some(true)"
        }
      ]
    },
    {
