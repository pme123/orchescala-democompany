        },
        {
          "name" : "skippedStatuses",
          "expression" : "= skippedStatuses",
          "description" : "Skipped _contractStatuses_ for _bpmn-contract-createUpdate_.\n                     |\n                     |Example: `[80, 90]`\n                     |\n                     |Default: `[$contractStatus]`\n                     |"
        }
      ],
      "outputs" : [
        {
          "name" : "contractKey",
          "expression" : "= contractKey",
          "description" : "For testing. If skipped this may be None."
        },
        {
          "name" : "contractStatus",
          "expression" : "= contractStatus",
          "description" : "For testing.",
          "required" : true
        },
        {
          "name" : "newContractType",
          "expression" : "= newContractType",
          "description" : "For testing.",
          "required" : true
        },
        {
          "name" : "processStatus",
          "expression" : "= processStatus",
          "required" : true
        },
        {
          "name" : "createUpdateProcessStatus",
          "expression" : "= createUpdateProcessStatus"
        }
      ]
