        },
        {
          "name" : "level",
          "expression" : "= level",
          "description" : "Validity area of the payment rule\n\nNote: The enum value 'Account' means 'Account/custody account'",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "levelKey",
          "expression" : "= levelKey",
          "description" : "Technical sequence number of the client, portfolio or account/custody account",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "validAfter",
          "expression" : "= validAfter",
          "description" : "Time at which the validity of the payment rule starts (excl.)\n- Format: date",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "validUntil",
          "expression" : "= validUntil",
          "description" : "Time at which the validity of the payment rule ends (incl.)\n- Format: date",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "initiatorKey",
          "expression" : "= initiatorKey",
          "description" : "Technical sequence number of the bank employee who initiated the payment rule",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "currency",
          "expression" : "= currency",
          "description" : "The currency dialog code is provided/returned for the attribute 'currency' (payment rule currency).\nThis is an external representation of the currency reference.\nOnly for certain special \"currencies\" like precious metals, the value may differ from the corresponding ISO currency code (ISO 4217).\n\nThe parameterisation of the business case type determines the characteristic and restriction of the possible currency assignment.",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "securitiesKey",
          "expression" : "= securitiesKey",
          "description" : "Technical securities sequence number",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "contractKey",
          "expression" : "= contractKey",
          "description" : "Technical sequence number of the contract",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "businessCaseGroupNumber",
          "expression" : "= businessCaseGroupNumber",
          "description" : "Reference to the business case type that concerns the payment rule.\nThe parameterisation of the business case type determines the characteristics and restrictions of the possible business case assignments.\nThe specified lookup resource delivers the meta data for this.",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "businessCases",
          "expression" : "= businessCases",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "comment",
          "expression" : "= comment",
          "description" : "Comment regarding payment rule for internal bank use",
          "variants" : [
            "Explicit"
          ]
        },
        {
          "name" : "paymentRuleCreating",
          "expression" : "= paymentRuleCreating",
          "description" : "Describes a payment rule of a client with the data for creation",
          "required" : true,
          "variants" : [
            "Standard"
          ]
        }
      ],
      "outputs" : [
        {
          "name" : "resourceUri",
          "expression" : "= resourceUri"
        },
        {
          "name" : "paymentRuleKey",
          "expression" : "= paymentRuleKey"
        }
      ]
    },
