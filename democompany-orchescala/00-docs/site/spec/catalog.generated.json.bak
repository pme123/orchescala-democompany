      "name" : "Onboarding.Out",
      "pkg" : "valiant.onboarding.domain.onboarding.v2",
      "kind" : "enum",
      "owner" : "Onboarding",
      "importPath" : "valiant.onboarding.domain.onboarding.v2.Onboarding",
      "source" : "valiant-onboarding/01-domain/src/main/scala/valiant/onboarding/domain/onboarding/v2/Onboarding.scala",
      "imports" : [
        "swisscom.fil.is.domain.ClientType",
        "valiant.bpmn.domain.sendProcessEvent.v1.SendProcessEvent",
        "valiant.depot.domain.openPensionAccount3a.v1.schema.NewPensionProduct",
