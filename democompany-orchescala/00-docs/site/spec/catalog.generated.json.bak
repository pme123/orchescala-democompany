        "valiant.product.domain.orderEBankingContract.v1.OrderEBankingContract",
        "valiant.services.domain.tad.v1.PostDuplicateCheck"
      ],
      "values" : [
        "Success",
        "Canceled"
      ],
      "cases" : [
        {
          "name" : "Success",
          "fields" : [
            {
              "name" : "processStatus",
              "type" : "CustomProcessStatus",
              "example" : "CustomProcessStatus.onboarded"
            },
            {
              "name" : "pepCheck",
              "type" : "Boolean",
              "example" : "false"
            },
            {
              "name" : "onboardingAccepted",
              "type" : "Boolean",
              "example" : "true"
            },
            {
              "name" : "potentialDuplicates",
              "type" : "Boolean",
              "example" : "false"
            },
            {
              "name" : "onboardingStatus",
              "type" : "OnboardingStatus",
              "example" : "OnboardingStatus.green"
            },
            {
              "name" : "callingProcessKeyDE",
              "type" : "String",
              "description" : "callingProcessKeyDEDescr",
              "descriptionExpr" : "callingProcessKeyDEDescr",
              "example" : "processLabels.de"
            },
            {
              "name" : "callingProcessKeyFR",
              "type" : "String",
              "description" : "callingProcessKeyFRDescr",
              "descriptionExpr" : "callingProcessKeyFRDescr",
              "example" : "processLabels.fr"
            }
          ]
        },
        {
          "name" : "Canceled",
          "fields" : [
            {
              "name" : "processStatus",
              "type" : "ProcessStatus.canceled.type",
              "default" : "ProcessStatus.canceled",
              "example" : "ProcessStatus.canceled"
            },
            {
              "name" : "pepCheck",
              "type" : "Boolean",
              "example" : "false"
            },
            {
              "name" : "onboardingAccepted",
              "type" : "Option[Boolean]",
              "example" : "Some(true)"
            },
            {
              "name" : "potentialDuplicates",
              "type" : "Boolean",
              "example" : "false"
            },
            {
              "name" : "onboardingStatus",
              "type" : "OnboardingStatus",
              "example" : "OnboardingStatus.green"
            }
          ]
        }
      ],
      "processName" : "valiant-onboarding-onboardingV2",
      "dsl" : "Process",
      "ownerDescr" : "Onboarding Process for Portal."
    },
