        {
          "name" : "processDefinitionKeyNotIn",
          "expression" : "= processDefinitionKeyNotIn",
          "description" : "Exclude instances by a comma-separated list of process definition keys.\n          A process instance must not have one of the given process definition keys."
        },
        {
          "name" : "deploymentId",
          "expression" : "= deploymentId",
          "description" : "Filter by the deployment the id belongs to."
        },
        {
          "name" : "superProcessInstance",
          "expression" : "= superProcessInstance",
          "description" : "Restrict query to all process instances that are sub process instances of the given process instance.\n          Takes a process instance id."
        },
        {
          "name" : "subProcessInstance",
          "expression" : "= subProcessInstance",
          "description" : "Restrict query to all process instances that have the given process instance as a sub process instance.\n          Takes a process instance id."
        },
        {
          "name" : "superCaseInstance",
          "expression" : "= superCaseInstance",
          "description" : "Restrict query to all process instances that are sub process instances of the given case instance.\n          Takes a case instance id."
        },
        {
          "name" : "subCaseInstance",
          "expression" : "= subCaseInstance",
          "description" : "Restrict query to all process instances that have the given case instance as a sub case instance.\n          Takes a case instance id."
        },
        {
          "name" : "active",
          "expression" : "= active",
          "description" : "Only include active process instances. Value may only be true,\n          as false is the default behavior."
        },
        {
          "name" : "suspended",
          "expression" : "= suspended",
          "description" : "Only include suspended process instances. Value may only be true,\n          as false is the default behavior."
        },
        {
          "name" : "withIncident",
          "expression" : "= withIncident",
          "description" : "Filter by presence of incidents. Selects only process instances that have an incident."
        },
        {
          "name" : "incidentId",
          "expression" : "= incidentId",
          "description" : "Filter by the incident id."
        },
        {
          "name" : "incidentType",
          "expression" : "= incidentType",
          "description" : "Filter by the incident type.\n          See the [User Guide](https://docs.camunda.org/manual/7.20/user-guide/process-engine/incidents/#incident-types)\n          for a list of incident types."
        },
        {
          "name" : "incidentMessage",
          "expression" : "= incidentMessage",
          "description" : "Filter by the incident message. Exact match."
        },
        {
          "name" : "incidentMessageLike",
          "expression" : "= incidentMessageLike",
          "description" : "Filter by the incident message that the parameter is a substring of."
        },
        {
          "name" : "tenantIdIn",
          "expression" : "= tenantIdIn",
          "description" : "Filter by a comma-separated list of tenant ids. A process instance must have one of the given tenant ids."
        },
        {
          "name" : "withoutTenantId",
          "expression" : "= withoutTenantId",
          "description" : "Only include process instances which belong to no tenant."
        },
        {
          "name" : "processDefinitionWithoutTenantId",
          "expression" : "= processDefinitionWithoutTenantId",
          "description" : "Only include process instances which process definition has no tenant id."
        },
        {
          "name" : "activityIdIn",
          "expression" : "= activityIdIn",
          "description" : "Filter by a comma-separated list of activity ids.\n          A process instance must currently wait in a leaf activity with one of the given activity ids."
        },
        {
          "name" : "rootProcessInstances",
          "expression" : "= rootProcessInstances",
          "description" : "Restrict the query to all process instances that are top level process instances."
        },
        {
          "name" : "leafProcessInstances",
          "expression" : "= leafProcessInstances",
          "description" : "Restrict the query to all process instances that are leaf instances. (i.e. don't have any sub instances)."
        },
        {
          "name" : "variables",
          "expression" : "= variables",
          "description" : "Only include process instances that have variables with certain values.\nVariable filtering expressions are comma-separated and are structured as follows:\n\nA valid parameter value has the form `key_operator_value`. `key` is the variable name,\n`operator` is the comparison operator to be used and `value` the variable value.\n\n**Note**: Values are always treated as String objects on server side.\n\nValid `operator` values are:\n`eq` - equal to;\n`neq` - not equal to;\n`gt` - greater than;\n`gteq` - greater than or equal to;\n`lt` - lower than;\n`lteq` - lower than or equal to;\n`like`.\n`key` and `value` may not contain underscore or comma characters."
        },
        {
          "name" : "variableNamesIgnoreCase",
          "expression" : "= variableNamesIgnoreCase",
          "description" : "Match all variable names in this query case-insensitively.\n          If set to true variableName and variablename are treated as equal."
        },
        {
          "name" : "variableValuesIgnoreCase",
          "expression" : "= variableValuesIgnoreCase",
          "description" : "Match all variable values in this query case-insensitively.\n          If set to true variableValue and variablevalue are treated as equal."
        }
      ],
      "outputs" : [
        {
          "name" : "processInstances",
          "expression" : "= processInstances",
          "required" : true
        },
        {
          "name" : "processInstanceIds",
          "expression" : "= processInstanceIds",
          "required" : true
        },
        {
          "name" : "hasProcessInstances",
          "expression" : "= hasProcessInstances",
          "description" : "true if there is at least one ProcessInstance.",
          "required" : true
        }
      ]
    },
    {
      "id" : "valiant-services-camundaV7.GetVariableInstance",
      "name" : "GetVariableInstance",
      "group" : "Valiant Services",
      "description" : "Query for variable instances that fulfill given parameters. Parameters may be the",
      "topic" : "valiant-services-camundaV7.GetVariableInstance",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "variableName",
          "expression" : "= variableName",
          "description" : "Filter by variable instance name."
        },
        {
          "name" : "variableNameLike",
          "expression" : "= variableNameLike",
          "description" : "Filter by the variable instance name. The parameter can include the wildcard `%` to\n          express like-strategy such as: starts with (`%`name), ends with (name`%`) or\n          contains (`%`name`%`)."
        },
        {
          "name" : "processInstanceIdIn",
          "expression" : "= processInstanceIdIn",
          "description" : "Only include variable instances which belong to one of the passed and comma-separated\n          process instance ids."
        },
        {
          "name" : "executionIdIn",
          "expression" : "= executionIdIn",
          "description" : "Only include variable instances which belong to one of the passed and comma-separated\n          execution ids."
        },
        {
          "name" : "taskIdIn",
          "expression" : "= taskIdIn",
          "description" : "Only include variable instances which belong to one of the passed and comma-separated task\n          ids."
        },
        {
          "name" : "batchIdIn",
          "expression" : "= batchIdIn",
          "description" : "Only include variable instances which belong to one of the passed and comma-separated\n          batch ids."
        },
        {
          "name" : "activityInstanceIdIn",
          "expression" : "= activityInstanceIdIn",
          "description" : "Only include variable instances which belong to one of the passed and comma-separated\n          activity instance ids."
        },
        {
          "name" : "tenantIdIn",
          "expression" : "= tenantIdIn",
          "description" : "Only include variable instances which belong to one of the passed and comma-separated\n          tenant ids."
        },
        {
          "name" : "variableValues",
          "expression" : "= variableValues",
          "description" : "Only include variable instances that have the certain values.\nValue filtering expressions are comma-separated and are structured as\nfollows:\n\nA valid parameter value has the form `key_operator_value`.\n`key` is the variable name, `operator` is the comparison operator to be used\nand `value` the variable value.\n\n**Note:** Values are always treated as `String` objects on server side.\n\nValid operator values are: `eq` - equal to; `neq` - not equal to; `gt` -\ngreater than;\n`gteq` - greater than or equal to; `lt` - lower than; `lteq` - lower than or\nequal to;\n`like`.\n`key` and `value` may not contain underscore or comma characters."
        },
        {
          "name" : "variableNamesIgnoreCase",
          "expression" : "= variableNamesIgnoreCase",
          "description" : "Match all variable names provided in `variableValues` case-insensitively. If set to `true`\n          **variableName** and **variablename** are treated as equal."
        },
        {
          "name" : "variableValuesIgnoreCase",
          "expression" : "= variableValuesIgnoreCase",
          "description" : "Match all variable values provided in `variableValues` case-insensitively. If set to\n          `true` **variableValue** and **variablevalue** are treated as equal."
        },
        {
          "name" : "variableScopeIdIn",
          "expression" : "= variableScopeIdIn",
          "description" : "Only include variable instances which belong to one of passed scope ids."
        },
        {
          "name" : "sortBy",
          "expression" : "= sortBy",
          "description" : "Sort the results lexicographically by a given criterion.\n          Must be used in conjunction with the sortOrder parameter."
        },
        {
          "name" : "sortOrder",
          "expression" : "= sortOrder",
          "description" : "Sort the results in a given order. Values may be asc for ascending order or desc for descending order.\n          Must be used in conjunction with the sortBy parameter."
        },
        {
          "name" : "firstResult",
          "expression" : "= firstResult",
          "description" : "Pagination of results. Specifies the index of the first result to return."
        },
        {
          "name" : "maxResults",
          "expression" : "= maxResults",
          "description" : "Pagination of results. Specifies the maximum number of results to return.\n          Will return less results if there are no more results left."
        }
      ],
      "outputs" : [
        {
          "name" : "variables",
          "expression" : "= variables",
          "description" : "A list of variable instances. If there are none an empty list will be returned",
          "required" : true
        },
        {
          "name" : "variable",
          "expression" : "= variable",
          "description" : "The first variable instance if there is at least one."
        },
        {
          "name" : "variableValueAsString",
          "expression" : "= variableValueAsString",
          "description" : "The value of the variable as String."
        }
      ]
    },
