    {
      "id" : "valiant-bpmn-contract-createUpdate",
      "name" : "valiant-bpmn-contract-createUpdate",
      "group" : "valiant-bpmn-communicationEntry-createUpdate",
      "description" : "Create or Update a UpdateContract that is not yet in the right Status.",
      "kind" : "call",
      "calledProcess" : "valiant-bpmn-contract-createUpdate",
      "inputs" : [
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "Technical client key of the client",
          "required" : true
        },
        {
          "name" : "contractKey",
          "expression" : "= contractKey",
          "description" : "Technical key of the contract - only set for an update"
        },
        {
          "name" : "existingContractStatus",
          "expression" : "= existingContractStatus",
          "description" : "Status code of the existing contract [integer ($int32)  maximum: 99  minimum: 1].\n\nThis is taken to check if it can be skipped or must be created -> Status `99` (cancelled).\nIf not set, it will be taken from `contract.contractStatus`."
        },
        {
          "name" : "contract",
          "expression" : "= contract",
          "description" : "The UpdateContract you want to be updated or created.\nThe only difference to _valiant.fil.is.domain.contract.v3.schema.Contract_ is the optional _contractKey_.\nIf you only need the _contractStatus_ and the _contractType_ you can use these attributes instead (_newContractStatus_)."
        },
        {
          "name" : "contractType",
          "expression" : "= contractType",
          "description" : "Code of the contract / this must not change between existing- and new UpdateContract. [integer ($int32)  maximum: 9999  minimum: 1].\n\nRequired if you NOT provide the `contract.contractType`."
        },
        {
          "name" : "newContractStatus",
          "expression" : "= newContractStatus",
          "description" : "Status code of the new contract [integer ($int32)  maximum: 99  minimum: 1].\nIf not set, `contract.contractStatus` is required and will be taken."
        },
        {
          "name" : "skippedStatuses",
          "expression" : "= skippedStatuses",
          "description" : "Skipped _contractStatuses_.\n                     |\n                     |Example: `[80, 90]`\n                     |\n                     |Default: `[$newContractStatus]` or `[90]` if `newContractStatus` is also not set.\n                     |"
        }
      ],
      "outputs" : [
        {
          "name" : "contractKey",
          "expression" : "= contractKey",
          "description" : "There is already a contractKey or this is the created one.",
          "required" : true
        },
        {
          "name" : "newContract",
          "expression" : "= newContract",
          "description" : "The UpdateContract that was created or the one that was updated.",
          "required" : true
        },
        {
          "name" : "processStatus",
          "expression" : "= processStatus",
          "required" : true
        }
      ]
    },
    {
      "id" : "valiant-bpmn-contract-createUpdateForPartner",
      "name" : "valiant-bpmn-contract-createUpdateForPartner",
