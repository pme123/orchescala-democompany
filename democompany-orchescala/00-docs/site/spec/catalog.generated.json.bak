      "id" : "valiant-fil-is-contractV5.contract.get",
      "name" : "contract.get",
      "group" : "valiant-fil-is-codes-getCodes",
      "description" : "Search for contracts with different filters. At least one of the following parameters has to be filled: client key, card number, account key, contract ID.",
      "topic" : "valiant-fil-is-contractV5.contract.get",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "contractIdFromToken",
          "expression" : "= contractIdFromToken",
          "description" : "Flag to indicate if you want to extract the Contract ID from the actual User (preferred_username of the Token).\n\n **Be aware** you need to set the _impersonateUserId_ variable, in order that this works!\n\n\n If this is not possible, use this input mapping:\n```\ncontractIdFromToken = execution.getVariable('contractIdFromToken')\ncontractId = execution.getVariable('contractId')\nif(contractIdFromToken){\n  // returns for example FSSO_6300--20N0101654\n  String[] splitted = impersonateUserId.split(\"--\")\n  // take the last element\n  contractId = splitted[splitted.length - 1]\n}\n\ncontractId\n```\nDefault is `false`."
        },
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "Filter for the client key (contract partner). At least one of the following parameters has to be filled: client key, card number, account key, contract ID."
        },
        {
          "name" : "currentUser",
          "expression" : "= currentUser",
          "description" : "With External Tasks there is no direct access to the `currentUser()`."
        },
        {
          "name" : "contractType",
          "expression" : "= contractType",
          "description" : "Filter for the contract type."
        },
        {
          "name" : "contractId",
          "expression" : "= contractId",
          "description" : "Filter for the contract ID."
        },
        {
          "name" : "cardNo",
          "expression" : "= cardNo",
          "description" : "Filter for the card number."
        },
        {
          "name" : "accountKey",
          "expression" : "= accountKey",
          "description" : "Filter for the technical account key."
        },
        {
          "name" : "contractStatus",
          "expression" : "= contractStatus",
          "description" : "Filter for the contract status."
        }
      ],
      "outputs" : [
        {
          "name" : "contracts",
          "expression" : "= contracts",
          "required" : true
        },
        {
          "name" : "contract",
          "expression" : "= contract",
          "description" : "Takes the first _IBContract_ from the _contracts_ sorted by the contractStatus (it takes only the _IBContract_ with status 99 if there is not another one)"
        },
        {
          "name" : "contractKey",
          "expression" : "= contractKey",
          "description" : "_contractKey_ of the _contract_.\n\n- _contract_: Takes the first _IBContract_ from the _contracts_ sorted by the contractStatus (it takes only the _IBContract_ with status 99 if there is not another one)"
        },
        {
          "name" : "contractStatus",
          "expression" : "= contractStatus",
          "description" : "_contractStatus_ of the _contract_."
        },
        {
          "name" : "contractType",
          "expression" : "= contractType",
          "description" : "_contractType_ of the _contract_."
        },
        {
          "name" : "contractId",
          "expression" : "= contractId",
          "description" : "Bank-internal identification of the contract [Constraints: maxLength: 10]"
        }
      ]
    },
