      ],
      "fields" : [
        {
          "name" : "cardVariety",
          "type" : "Option[Int]",
          "description" : "Finnova-specific card variety, e.g. STUcard, Maestro Gold, etc.",
          "example" : "Some(12)"
        },
        {
          "name" : "cardKey",
          "type" : "Option[Long]",
          "description" : "Card key (technical)",
          "example" : "Some(defaultCardKey)"
        },
        {
          "name" : "cardStatus",
          "type" : "Option[Int]",
          "description" : "Finnova-specific card status",
          "example" : "Some(10)"
        },
        {
          "name" : "sixCode",
          "type" : "Option[SixCode]",
          "description" : "Card system - Maestro, credit card, VPay, etc.",
          "example" : "Some(SixCode.BANK_CARD)"
        },
        {
          "name" : "cardLimit",
          "type" : "Option[Double]",
          "description" : "Card limit, credit card (according to doc this is double - but service returns integer)",
          "example" : "None"
        },
        {
          "name" : "accountKey",
          "type" : "Option[Long]",
          "description" : "Account key (technical) - according to FIL docu this should be required, but with Valiant there are cards that have no accountKey - maybe prepaid cards.",
          "example" : "Some(defaultAccountKey)"
        },
        {
          "name" : "clientKey",
          "type" : "Option[Long]",
          "description" : "Client key of cardholder (technical)",
          "example" : "Some(defaultClientKey)"
        },
        {
          "name" : "accountHolderClientKey",
          "type" : "Option[Long]",
          "description" : "Client key of account holder",
          "example" : "Some(66228878229150L)"
        },
        {
          "name" : "cardBlockingCode",
          "type" : "Option[Int]",
          "description" : "Blocking code",
          "example" : "Some(0)"
        },
        {
          "name" : "cardCurrency",
          "type" : "Option[String]",
          "description" : "ISO code of the account and card currency",
          "example" : "Some(\"CHF\")"
        },
        {
          "name" : "expiryDate",
          "type" : "Option[LocalDate]",
          "description" : "Expiry date",
          "example" : "Some(LocalDate.parse(\"2099-12-12\"))"
        },
        {
          "name" : "displayCardNumber",
          "type" : "Option[String]",
          "description" : "Card number for display. This card number is meant for display. It\ntherefore comes in an attractive printed format with spaces between\ngroups of digits. These are groups of four digits in the case of\ncredit cards and Swiss Bankers cards and a card number with a\nsubsequent sequence number for debit cards.",
          "example" : "Some(\"92088469-0\")"
        },
        {
          "name" : "embossedLineOne",
          "type" : "Option[String]",
          "description" : "Print name on the card (first and last name) of the account holder\nor the authorised representative",
          "example" : "Some(\"PETER PAN\")"
        },
        {
          "name" : "issuer",
          "type" : "Option[Issuer]",
          "example" : "Some(Issuer.SIX)"
        },
        {
          "name" : "category",
          "type" : "Option[CardCategory]",
          "example" : "Some(CardCategory.CREDIT)"
        },
        {
          "name" : "isCardActive",
          "type" : "Option[Boolean]",
          "example" : "Some(true)"
        },
        {
          "name" : "hasOpenOrder",
          "type" : "Option[Boolean]",
          "description" : "Does open order exist for this card?",
          "example" : "Some(false)"
        },
        {
          "name" : "cardDisplayType",
          "type" : "Option[String]",
          "description" : "Card type identifier for overviews incl. ODS subtypes",
          "example" : "Some(\"554\")"
        }
      ]
