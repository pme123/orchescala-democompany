    {
      "id" : "valiant-fil-is-duplicateV1.duplicates.get",
      "name" : "duplicates.get",
      "group" : "valiant-fil-is-codes-getCodes",
      "description" : "Checks whether there is already a client with the same or similar values in the database.",
      "topic" : "valiant-fil-is-duplicateV1.duplicates.get",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "name",
          "expression" : "= name",
          "description" : "Last name of the client or company name in the case of a company",
          "required" : true
        },
        {
          "name" : "firstName",
          "expression" : "= firstName",
          "description" : "First name of the client"
        },
        {
          "name" : "dateOfBirth",
          "expression" : "= dateOfBirth",
          "description" : "Date of birth (yyyy-MM-dd) of the client;\n          - Format: date"
        },
        {
          "name" : "namePartner",
          "expression" : "= namePartner",
          "description" : "Last name of the client's partner"
        },
        {
          "name" : "firstNamePartner",
          "expression" : "= firstNamePartner",
          "description" : "First name of the client's partner"
        },
        {
          "name" : "dateOfBirthPartner",
          "expression" : "= dateOfBirthPartner",
          "description" : "Date of birth (yyyy-MM-dd) of the client's partner;\n          - Format: date"
        },
        {
          "name" : "postcode",
          "expression" : "= postcode",
          "description" : "Additional check - if set only clients with this **postcode** are taken as duplicates."
        },
        {
          "name" : "place",
          "expression" : "= place",
          "description" : "Additional check - if set only clients with this **place** are taken as duplicates."
        },
        {
          "name" : "clientMainType",
          "expression" : "= clientMainType",
          "description" : "Additional check - if set only clients with this **clientMainType** are taken as duplicates."
        },
        {
          "name" : "clientStatus",
          "expression" : "= clientStatus",
          "description" : "Additional check - if set only clients with these **clientStatus** are taken as duplicates."
        }
      ],
      "outputs" : [
        {
          "name" : "possibleDuplicates",
          "expression" : "= possibleDuplicates",
          "required" : true
        },
        {
          "name" : "hasDuplicates",
          "expression" : "= hasDuplicates",
          "description" : "True if there are Duplicates.",
          "required" : true
        },
        {
          "name" : "duplicatesCount",
          "expression" : "= duplicatesCount",
          "required" : true
        }
      ]
    },
