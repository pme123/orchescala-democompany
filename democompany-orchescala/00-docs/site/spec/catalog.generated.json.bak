          "description" : "Skip deletion of the subprocesses related to deleted processes as part of this request."
        },
        {
          "name" : "processInstanceQuery",
          "expression" : "= processInstanceQuery",
          "description" : "A process instance query which defines a group of process instances"
        },
        {
          "name" : "historicProcessInstanceQuery",
          "expression" : "= historicProcessInstanceQuery",
          "description" : "A historic process instance query which defines a group of historic process instances"
        }
      ],
      "outputs" : [
        {
          "name" : "id",
          "expression" : "= id",
          "description" : "The id of the batch."
        },
        {
          "name" : "type",
          "expression" : "= type",
          "description" : "The type of the batch.\nSee the [User Guide](https://docs.camunda.org/manual/7.20/user-guide/process-engine/batch/#creating-a-batch)\nfor more information about batch types."
        },
        {
          "name" : "totalJobs",
          "expression" : "= totalJobs",
          "description" : "The total jobs of a batch is the number of batch execution jobs required to complete the batch.\n- Format: int32"
        },
        {
          "name" : "jobsCreated",
          "expression" : "= jobsCreated",
          "description" : "The number of batch execution jobs already created by the seed job.\n- Format: int32"
        },
        {
          "name" : "batchJobsPerSeed",
          "expression" : "= batchJobsPerSeed",
          "description" : "The number of batch execution jobs created per seed job invocation.\nThe batch seed job is invoked until it has created all batch execution jobs required by the batch\n(see `totalJobs` property).\n- Format: int32"
        },
        {
          "name" : "invocationsPerBatchJob",
          "expression" : "= invocationsPerBatchJob",
          "description" : "Every batch execution job invokes the command executed by the batch `invocationsPerBatchJob` times.\nE.g., for a process instance migration batch this specifies the number of process instances which are migrated per batch execution job.\n- Format: int32"
        },
        {
          "name" : "seedJobDefinitionId",
          "expression" : "= seedJobDefinitionId",
          "description" : "The job definition id for the seed jobs of this batch."
        },
        {
          "name" : "monitorJobDefinitionId",
          "expression" : "= monitorJobDefinitionId",
          "description" : "The job definition id for the monitor jobs of this batch."
        },
        {
          "name" : "batchJobDefinitionId",
          "expression" : "= batchJobDefinitionId",
          "description" : "The job definition id for the batch execution jobs of this batch."
        },
        {
          "name" : "suspended",
          "expression" : "= suspended",
          "description" : "Indicates whether this batch is suspended or not."
        },
        {
          "name" : "tenantId",
          "expression" : "= tenantId",
          "description" : "The tenant id of the batch."
        },
        {
          "name" : "createUserId",
          "expression" : "= createUserId",
          "description" : "The id of the user that created the batch."
        },
        {
          "name" : "startTime",
          "expression" : "= startTime",
          "description" : "The time the batch was started. Default format `yyyy-MM-dd'T'HH:mm:ss.SSSZ`. For further information,\nplease see the [documentation] (https://docs.camunda.org/manual/7.20/reference/rest/overview/date-format/)\n- Format: date-time"
        },
        {
          "name" : "executionStartTime",
          "expression" : "= executionStartTime",
          "description" : "The time the batch execution was started, i.e., at least one batch job has been executed. Default\nformat `yyyy-MM-dd'T'HH:mm:ss.SSSZ`. For further information, please see the [documentation]\n(https://docs.camunda.org/manual/7.20/reference/rest/overview/date-format/)\n- Format: date-time"
        }
      ]
    },
