      "id" : "valiant.services.domain.camunda.v7.GetExternalTask.In",
      "name" : "GetExternalTask.In",
      "pkg" : "valiant.services.domain.camunda.v7",
      "kind" : "case",
      "owner" : "GetExternalTask",
      "importPath" : "valiant.services.domain.camunda.v7.GetExternalTask",
      "source" : "valiant-services/01-domain/src/main/scala/valiant/services/domain/camunda/v7/GetExternalTask.scala",
      "imports" : [
        "valiant.services.domain.camunda.v7.schema.*"
      ],
      "fields" : [
        {
          "name" : "externalTaskId",
          "type" : "Option[String]",
          "description" : "Filter by an external task's id.",
          "example" : "None"
        },
        {
          "name" : "externalTaskIdIn",
          "type" : "Option[String]",
          "description" : "Filter by the comma-separated list of external task ids.",
          "example" : "None"
        },
        {
          "name" : "topicName",
          "type" : "Option[String]",
          "description" : "Filter by an external task topic.",
          "example" : "None"
        },
        {
          "name" : "workerId",
          "type" : "Option[String]",
          "description" : "Filter by the id of the worker that the task was most recently locked by.",
          "example" : "None"
        },
        {
          "name" : "locked",
          "type" : "Option[Boolean]",
          "description" : "Only include external tasks that are currently locked (i.e., they have a lock time and it has not expired).\nValue may only be `true`, as `false` matches any external task.",
          "example" : "None"
        },
        {
          "name" : "notLocked",
          "type" : "Option[Boolean]",
          "description" : "Only include external tasks that are currently not locked (i.e., they have no lock or it has expired).\nValue may only be `true`, as `false` matches any external task.",
          "example" : "None"
        },
        {
          "name" : "withRetriesLeft",
          "type" : "Option[Boolean]",
          "description" : "Only include external tasks that have a positive (&gt; 0) number of retries (or `null`). Value may only be\n`true`, as `false` matches any external task.",
          "example" : "None"
        },
        {
          "name" : "noRetriesLeft",
          "type" : "Option[Boolean]",
          "description" : "Only include external tasks that have 0 retries. Value may only be `true`, as `false` matches any\nexternal task.",
          "example" : "None"
        },
        {
          "name" : "lockExpirationAfter",
          "type" : "Option[LocalDateTime]",
          "description" : "Restrict to external tasks that have a lock that expires after a given date. By\n[default](https://docs.camunda.org/manual/7.20/reference/rest/overview/date-format/), the date must have the format\n`yyyy-MM-dd'T'HH:mm:ss.SSSZ`, e.g., `2013-01-23T14:42:45.000+0200`.\n- Format: date-time",
          "example" : "None"
        },
        {
          "name" : "lockExpirationBefore",
          "type" : "Option[LocalDateTime]",
          "description" : "Restrict to external tasks that have a lock that expires before a given date. By\n[default](https://docs.camunda.org/manual/7.20/reference/rest/overview/date-format/), the date must have the format\n`yyyy-MM-dd'T'HH:mm:ss.SSSZ`, e.g., `2013-01-23T14:42:45.000+0200`.\n- Format: date-time",
          "example" : "None"
        },
        {
          "name" : "activityId",
          "type" : "Option[String]",
          "description" : "Filter by the id of the activity that an external task is created for.",
          "example" : "None"
        },
        {
          "name" : "activityIdIn",
          "type" : "Option[String]",
          "description" : "Filter by the comma-separated list of ids of the activities that an external task is created for.",
          "example" : "None"
        },
        {
          "name" : "executionId",
          "type" : "Option[String]",
          "description" : "Filter by the id of the execution that an external task belongs to.",
          "example" : "None"
        },
        {
          "name" : "processInstanceId",
          "type" : "Option[String]",
          "description" : "Filter by the id of the process instance that an external task belongs to.",
          "example" : "None"
        },
        {
          "name" : "processInstanceIdIn",
          "type" : "Option[String]",
          "description" : "Filter by a comma-separated list of process instance ids that an external task may belong to.",
          "example" : "None"
        },
        {
          "name" : "processDefinitionId",
          "type" : "Option[String]",
          "description" : "Filter by the id of the process definition that an external task belongs to.",
          "example" : "None"
        },
        {
          "name" : "tenantIdIn",
          "type" : "Option[String]",
          "description" : "Filter by a comma-separated list of tenant ids.\nAn external task must have one of the given tenant ids.",
          "example" : "None"
        },
        {
          "name" : "active",
          "type" : "Option[Boolean]",
          "description" : "Only include active tasks. Value may only be `true`, as `false` matches any external task.",
          "example" : "Some(true)"
        },
        {
          "name" : "suspended",
          "type" : "Option[Boolean]",
          "description" : "Only include suspended tasks. Value may only be `true`, as `false` matches any external task.",
          "example" : "None"
        },
        {
          "name" : "priorityHigherThanOrEquals",
          "type" : "Option[Long]",
          "description" : "Only include jobs with a priority higher than or equal to the given value.\nValue must be a valid `long` value.\n- Format: int64",
          "example" : "None"
        },
        {
          "name" : "priorityLowerThanOrEquals",
          "type" : "Option[Long]",
          "description" : "Only include jobs with a priority lower than or equal to the given value.\nValue must be a valid `long` value.\n- Format: int64",
          "example" : "None"
        },
        {
          "name" : "sortBy",
          "type" : "Option[In.SortBy]",
          "description" : "Sort the results lexicographically by a given criterion.\nMust be used in conjunction with the sortOrder parameter.",
          "example" : "None"
        },
        {
          "name" : "sortOrder",
          "type" : "Option[In.SortOrder]",
          "description" : "Sort the results in a given order. Values may be asc for ascending order or desc for descending order.\nMust be used in conjunction with the sortBy parameter.",
          "example" : "None"
        },
        {
          "name" : "firstResult",
          "type" : "Option[Int]",
          "description" : "Pagination of results. Specifies the index of the first result to return.",
          "example" : "None"
        },
        {
          "name" : "maxResults",
          "type" : "Option[Int]",
          "description" : "Pagination of results. Specifies the maximum number of results to return.\nWill return less results if there are no more results left.",
          "example" : "None"
        }
      ],
      "topicName" : "valiant-services-camundaV7.GetExternalTask",
      "ownerDescr" : "Queries for the external tasks that fulfill given parameters. Parameters may be static as well as dynamic\nruntime properties of executions. The size of the result set can be retrieved by using the\n[Get External Task Count](https://docs.camunda.org/manual/7.20/reference/rest/external-task/get-query-count/) method."
    },
