      ],
      "fields" : [
        {
          "name" : "clientKey",
          "type" : "Long",
          "description" : "clientKeyDescr",
          "descriptionExpr" : "clientKeyDescr",
          "example" : "defaultClientKey"
        },
        {
          "name" : "doFilterDetails",
          "type" : "Option[Boolean]",
          "description" : "If you don't need the address and client information, set this to _false_. Default is _true_.",
          "example" : "None"
