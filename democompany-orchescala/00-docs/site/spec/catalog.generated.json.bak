    {
      "id" : "valiant-graviton-rdiV1.PostNotification",
      "name" : "PostNotification",
      "group" : "Valiant Graviton Services",
      "description" : "Creates a new notification.",
      "topic" : "valiant-graviton-rdiV1.PostNotification",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "contentDe",
          "expression" : "= contentDe",
          "description" : "Notification content in german",
          "required" : true
        },
        {
          "name" : "contentFr",
          "expression" : "= contentFr",
          "description" : "Notification content in french",
          "required" : true
        },
        {
          "name" : "noPersisting",
          "expression" : "= noPersisting",
          "description" : "if true the notification will not be persisted, regardless if it could be delivered or not."
        },
        {
          "name" : "topic",
          "expression" : "= topic",
          "description" : "An optional topic for this notification. If empty, it will be delivered to all users. Can be a comma separated list of topics to deliver it to multiple topics."
        },
        {
          "name" : "read",
          "expression" : "= read",
          "description" : "If this notification has been read or not, defaults to false."
        },
        {
          "name" : "notificationType",
          "expression" : "= notificationType",
          "description" : "A string you can freely set on the notification, used to associate something to it"
        },
        {
          "name" : "typeId",
          "expression" : "= typeId",
          "description" : "A string you can freely set on the notification, used to associate something to it (and possibly relates to \"type\")"
        },
        {
          "name" : "typeState",
          "expression" : "= typeState",
          "description" : "Another string you can relate things to."
        },
        {
          "name" : "typeBasedDeliveryBlockedInSeconds",
          "expression" : "= typeBasedDeliveryBlockedInSeconds",
          "description" : "If set, then a tuple will be built of the fields \"topic\", \"type\", \"typeId\" and \"typeState\" and it will be memorized for the amount of seconds that you pass. \nSo during that amount of time a redelivery of the same notification (with the same tuple field values) will be disabled. \nNote that the value of this fields is only checked if on subsequent notifications this field is also set!"
        }
      ],
      "outputs" : [
      ]
    },
    {
      "id" : "valiant-graviton-sspV1.PostSspAction",
