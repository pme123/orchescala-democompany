          "example" : "11"
        },
        {
          "name" : "residencePermitCode",
          "type" : "Option[Int]",
          "description" : "enum: 1, 2, 3, 4, 5, 6, 7, 8",
          "example" : "Some(2)"
        },
        {
          "name" : "relationshipToMainCardHolderValue",
          "type" : "Option[String]",
          "description" : "Only required for _additionalCardHolder_. - codetable: relationshipRoles",
          "example" : "Some(\"Ehefrau\")"
        },
        {
          "name" : "formOfAddress",
          "type" : "Int",
          "description" : "Form of address of the person - x-codetable: formOfAddress",
          "example" : "2"
        },
        {
          "name" : "title",
          "type" : "Option[Int]",
          "description" : "Code of the academic title - x-codetable: academicTitles",
          "example" : "None"
        },
        {
          "name" : "firstName",
          "type" : "String",
          "example" : "\"Daniel\""
        },
        {
          "name" : "name",
          "type" : "String",
          "example" : "\"Arnold\""
        },
        {
          "name" : "maritalStatus",
          "type" : "MaritalStatus",
          "example" : "MaritalStatus.MARRIED"
        },
        {
          "name" : "dateOfBirth",
          "type" : "String",
          "description" : "Date of birth of the client (only loaded if the date incl.  month and day is known - format: date. \nMust be String as it is formatted differently. dd.MM.yyyy",
          "example" : "formatToDay(defaultDateOfBirth)"
        },
        {
          "name" : "nationality",
          "type" : "String",
          "description" : "codesISO_3166 - 1 - Country code of the nationality (country / nationality) - codetable: countries",
          "example" : "\"CH\""
        },
        {
          "name" : "placeOfOrigin",
          "type" : "Option[String]",
          "description" : "Place of origin of client - codetable: places",
          "example" : "Some(\"Zürich\")"
        },
        {
          "name" : "residencePermitDate",
          "type" : "Option[String]",
          "description" : "Residence permit date\n- format: date \nMust be String as it is formatted differently. dd.MM.yyyy",
          "example" : "Some(formatToDay(defaultResidencePermitDate))"
        },
        {
          "name" : "clientLanguage",
          "type" : "Option[String]",
          "example" : "Some(\"de\")"
        },
        {
          "name" : "domicileAddress",
          "type" : "Address",
          "example" : "Address.example"
        },
        {
          "name" : "correspondenceAddress",
          "type" : "Option[Address]",
          "example" : "None"
        },
        {
          "name" : "telephoneNumber",
          "type" : "Option[String]",
          "example" : "Some(\"+417933333\")"
        },
        {
          "name" : "email",
          "type" : "Option[String]",
          "example" : "Some(\"my@email.ch\")"
        }
      ]
    },
