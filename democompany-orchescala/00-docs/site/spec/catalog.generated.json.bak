    {
      "id" : "valiant.graviton.domain.rdi.v1.PostNotification.In",
      "name" : "PostNotification.In",
      "pkg" : "valiant.graviton.domain.rdi.v1",
      "kind" : "case",
      "owner" : "PostNotification",
      "importPath" : "valiant.graviton.domain.rdi.v1.PostNotification",
      "source" : "valiant-graviton/01-domain/src/main/scala/valiant/graviton/domain/rdi/v1/PostNotification.scala",
      "imports" : [
        "valiant.graviton.domain.rdi.v1.schema.Notification"
      ],
      "fields" : [
        {
          "name" : "contentDe",
          "type" : "String",
          "description" : "Notification content in german",
          "example" : "s\"Es wurde ein neues Dokument für $defaultClientDesignation erstellt.\""
        },
        {
          "name" : "contentFr",
          "type" : "String",
          "description" : "Notification content in french",
          "example" : "s\"Un nouveau document a été créé pour $defaultClientDesignation.\""
        },
        {
          "name" : "noPersisting",
          "type" : "Option[Boolean]",
          "description" : "if true the notification will not be persisted, regardless if it could be delivered or not.",
          "example" : "Some(false)"
        },
        {
          "name" : "topic",
          "type" : "Option[String]",
          "description" : "An optional topic for this notification. If empty, it will be delivered to all users. Can be a comma separated list of topics to deliver it to multiple topics.",
          "example" : "Some(s\"$defaultClientKey\")"
        },
        {
          "name" : "read",
          "type" : "Option[Boolean]",
          "description" : "If this notification has been read or not, defaults to false.",
          "example" : "Some(false)"
        },
        {
          "name" : "notificationType",
          "type" : "Option[String]",
          "description" : "A string you can freely set on the notification, used to associate something to it",
          "example" : "Some(\"document-rendered\")"
        },
        {
          "name" : "typeId",
          "type" : "Option[String]",
          "description" : "A string you can freely set on the notification, used to associate something to it (and possibly relates to \"type\")",
          "example" : "Some(\"619cabf20b18165b614031c9\")"
        },
        {
          "name" : "typeState",
          "type" : "Option[String]",
          "description" : "Another string you can relate things to.",
          "example" : "Some(\"created\")"
        },
        {
          "name" : "typeBasedDeliveryBlockedInSeconds",
          "type" : "Option[Double]",
          "description" : "If set, then a tuple will be built of the fields \"topic\", \"type\", \"typeId\" and \"typeState\" and it will be memorized for the amount of seconds that you pass. \nSo during that amount of time a redelivery of the same notification (with the same tuple field values) will be disabled. \nNote that the value of this fields is only checked if on subsequent notifications this field is also set!",
          "example" : "Some(3600)"
        }
      ],
      "topicName" : "valiant-graviton-rdiV1.PostNotification",
      "ownerDescr" : "Creates a new notification.\nIf it has \"topic\" set it is sent to that topic.\nIf not, it is sent to all users. Additionally, it is persisted to database and delivered to all later users.\nAn exception is the \"singleDelivery\" flag - if delivered once, it will not be delivered"
    },
