    {
      "id" : "valiant-services-camundaV7.GetExternalTask",
      "name" : "GetExternalTask",
      "group" : "Valiant Services",
      "description" : "Queries for the external tasks that fulfill given parameters. Parameters may be static as well as dynamic",
      "topic" : "valiant-services-camundaV7.GetExternalTask",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "externalTaskId",
          "expression" : "= externalTaskId",
          "description" : "Filter by an external task's id."
        },
        {
          "name" : "externalTaskIdIn",
          "expression" : "= externalTaskIdIn",
          "description" : "Filter by the comma-separated list of external task ids."
        },
        {
          "name" : "topicName",
          "expression" : "= topicName",
          "description" : "Filter by an external task topic."
        },
        {
          "name" : "workerId",
          "expression" : "= workerId",
          "description" : "Filter by the id of the worker that the task was most recently locked by."
        },
        {
          "name" : "locked",
          "expression" : "= locked",
          "description" : "Only include external tasks that are currently locked (i.e., they have a lock time and it has not expired).\n          Value may only be `true`, as `false` matches any external task."
        },
        {
          "name" : "notLocked",
          "expression" : "= notLocked",
          "description" : "Only include external tasks that are currently not locked (i.e., they have no lock or it has expired).\n          Value may only be `true`, as `false` matches any external task."
        },
        {
          "name" : "withRetriesLeft",
          "expression" : "= withRetriesLeft",
          "description" : "Only include external tasks that have a positive (&gt; 0) number of retries (or `null`). Value may only be\n          `true`, as `false` matches any external task."
        },
        {
          "name" : "noRetriesLeft",
          "expression" : "= noRetriesLeft",
          "description" : "Only include external tasks that have 0 retries. Value may only be `true`, as `false` matches any\n          external task."
        },
        {
          "name" : "lockExpirationAfter",
          "expression" : "= lockExpirationAfter",
          "description" : "Restrict to external tasks that have a lock that expires after a given date. By\n          [default](https://docs.camunda.org/manual/7.20/reference/rest/overview/date-format/), the date must have the format\n          `yyyy-MM-dd'T'HH:mm:ss.SSSZ`, e.g., `2013-01-23T14:42:45.000+0200`.\n          - Format: date-time"
        },
        {
          "name" : "lockExpirationBefore",
          "expression" : "= lockExpirationBefore",
          "description" : "Restrict to external tasks that have a lock that expires before a given date. By\n          [default](https://docs.camunda.org/manual/7.20/reference/rest/overview/date-format/), the date must have the format\n          `yyyy-MM-dd'T'HH:mm:ss.SSSZ`, e.g., `2013-01-23T14:42:45.000+0200`.\n          - Format: date-time"
        },
        {
          "name" : "activityId",
          "expression" : "= activityId",
          "description" : "Filter by the id of the activity that an external task is created for."
        },
        {
          "name" : "activityIdIn",
          "expression" : "= activityIdIn",
          "description" : "Filter by the comma-separated list of ids of the activities that an external task is created for."
        },
        {
          "name" : "executionId",
          "expression" : "= executionId",
          "description" : "Filter by the id of the execution that an external task belongs to."
        },
        {
          "name" : "processInstanceId",
          "expression" : "= processInstanceId",
          "description" : "Filter by the id of the process instance that an external task belongs to."
        },
        {
          "name" : "processInstanceIdIn",
          "expression" : "= processInstanceIdIn",
          "description" : "Filter by a comma-separated list of process instance ids that an external task may belong to."
        },
        {
          "name" : "processDefinitionId",
          "expression" : "= processDefinitionId",
          "description" : "Filter by the id of the process definition that an external task belongs to."
        },
        {
          "name" : "tenantIdIn",
          "expression" : "= tenantIdIn",
          "description" : "Filter by a comma-separated list of tenant ids.\n          An external task must have one of the given tenant ids."
        },
        {
          "name" : "active",
          "expression" : "= active",
          "description" : "Only include active tasks. Value may only be `true`, as `false` matches any external task."
        },
        {
          "name" : "suspended",
          "expression" : "= suspended",
          "description" : "Only include suspended tasks. Value may only be `true`, as `false` matches any external task."
        },
        {
          "name" : "priorityHigherThanOrEquals",
          "expression" : "= priorityHigherThanOrEquals",
          "description" : "Only include jobs with a priority higher than or equal to the given value.\n          Value must be a valid `long` value.\n          - Format: int64"
        },
        {
          "name" : "priorityLowerThanOrEquals",
          "expression" : "= priorityLowerThanOrEquals",
          "description" : "Only include jobs with a priority lower than or equal to the given value.\n          Value must be a valid `long` value.\n          - Format: int64"
        },
        {
          "name" : "sortBy",
          "expression" : "= sortBy",
          "description" : "Sort the results lexicographically by a given criterion.\n          Must be used in conjunction with the sortOrder parameter."
        },
        {
          "name" : "sortOrder",
          "expression" : "= sortOrder",
          "description" : "Sort the results in a given order. Values may be asc for ascending order or desc for descending order.\n          Must be used in conjunction with the sortBy parameter."
        },
        {
          "name" : "firstResult",
          "expression" : "= firstResult",
          "description" : "Pagination of results. Specifies the index of the first result to return."
        },
        {
          "name" : "maxResults",
          "expression" : "= maxResults",
          "description" : "Pagination of results. Specifies the maximum number of results to return.\n          Will return less results if there are no more results left."
        }
      ],
      "outputs" : [
        {
          "name" : "externalTasks",
          "expression" : "= externalTasks",
          "required" : true
        },
        {
          "name" : "externalTasksWithoutError",
          "expression" : "= externalTasksWithoutError",
          "required" : true
        },
        {
          "name" : "externalTaskIds",
          "expression" : "= externalTaskIds",
          "required" : true
        },
        {
          "name" : "externalTaskIdsWithoutError",
          "expression" : "= externalTaskIdsWithoutError",
          "required" : true
        }
      ]
    },
