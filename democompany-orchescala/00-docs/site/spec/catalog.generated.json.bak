      "id" : "valiant-fil-is-paymentRuleV1.PostPaymentRules",
      "name" : "PostPaymentRules",
      "group" : "valiant-fil-is-codes-getCodes",
      "description" : "Create new payment rule of a client. At least one business case assignment must exist for each payment rule.",
      "topic" : "valiant-fil-is-paymentRuleV1.PostPaymentRules",
      "kind" : "service",
      "inputs" : [
        {
          "name" : "clientKey",
          "expression" : "= clientKey",
          "description" : "Technical sequence number of the client",
