      "importPath" : "valiant.services.domain.camunda.v7.schema.ProcessInstanceSort",
      "source" : "valiant-services/01-domain/src/main/scala/valiant/services/domain/camunda/v7/schema/ProcessInstanceQueryDto.scala",
      "values" : [
        "instanceId"
      ]
    },
