      "inputs" : [
        {
          "name" : "numberNameAlpha",
          "expression" : "= numberNameAlpha",
          "description" : "Search for client number, last name, first name (incl. wildcards) or symbol (\"alpha\") abbreviation.\n\nOne of these parameters must be set: numberNameAlpha, nameBeforeMarriage, postcodeOrPlace, postcodeOrPlace"
        },
        {
          "name" : "nameBeforeMarriage",
          "expression" : "= nameBeforeMarriage",
          "description" : "Name before marriage\n\nOne of these parameters must be set: numberNameAlpha, nameBeforeMarriage, postcodeOrPlace, postcodeOrPlace"
        },
        {
          "name" : "postcodeOrPlace",
          "expression" : "= postcodeOrPlace",
          "description" : "Postcode or place description\n\nOne of these parameters must be set: numberNameAlpha, nameBeforeMarriage, postcodeOrPlace, postcodeOrPlace"
        },
        {
          "name" : "dateOfBirth",
          "expression" : "= dateOfBirth",
          "description" : "Date of birth (yyyy-MM-dd)\n\nOne of these parameters must be set: numberNameAlpha, nameBeforeMarriage, postcodeOrPlace, postcodeOrPlace"
        },
        {
          "name" : "country",
          "expression" : "= country",
          "description" : "Domicile country code (ISO-2)"
        },
        {
          "name" : "includeBlocked",
          "expression" : "= includeBlocked",
          "description" : "Also include clients that have been closed since this date (yyyy-MM-dd)"
        },
        {
          "name" : "closedAsOf",
          "expression" : "= closedAsOf",
          "description" : "Also include clients with blocking (default: true)"
        }
      ],
      "outputs" : [
        {
          "name" : "clients",
          "expression" : "= clients",
          "required" : true
        },
        {
          "name" : "clientsFound",
          "expression" : "= clientsFound",
          "required" : true
        }
      ]
