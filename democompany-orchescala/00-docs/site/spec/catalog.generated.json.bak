          "type" : "Option[Boolean]",
          "description" : "If you also need the details of the received PoAs, set this to _true_. Default is _false_.",
          "example" : "None"
        },
        {
          "name" : "loadAccounts",
          "type" : "Option[Boolean]",
          "description" : "Flag if the accounts for the PoAs should be added to the PoAs assignmentAccounts. Default is _false_.",
          "example" : "Some(true)"
        },
        {
          "name" : "poaTypes",
          "type" : "Option[Seq[Int]]",
          "description" : "Filter for the PoA types. If set, only PoAs with these types are returned.",
          "example" : "None"
        },
        {
          "name" : "poaStatuses",
          "type" : "Option[Seq[Int]]",
          "description" : "Filter for the PoA statuses. If set, only PoAs with these statuses are returned.",
          "example" : "None"
        },
        {
          "name" : "signingAuthorities",
          "type" : "Option[Seq[Int]]",
