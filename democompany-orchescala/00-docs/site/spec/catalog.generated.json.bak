          "description" : "All Power of Attorneys of a client."
        },
        {
          "name" : "givenPoas",
          "expression" : "= givenPoas",
          "description" : "Power of Attorneys that I give to other people. (`poaClientKey = assignmentClients[0].clientKey`)"
        },
        {
          "name" : "receivedPoas",
          "expression" : "= receivedPoas",
          "description" : "Power of Attorneys that I received from other people. (`poaClientKey = poa.clientAssignedKey`)"
        },
        {
          "name" : "processStatus",
          "expression" : "= processStatus",
          "required" : true
        }
      ]
