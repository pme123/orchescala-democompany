          "name" : "clientDesignation",
          "type" : "Option[String]",
          "description" : "From FIL IS _clientadministration.api.v1.get_ > _clientDesignation_",
          "example" : "Some(defaultClientDesignation)"
        },
        {
          "name" : "editClientNumber",
          "type" : "Option[String]",
          "description" : "From FIL IS _clientadministration.api.v1.get_ > _master.editClientNumber_",
          "example" : "Some(defaultEditClientNumber)"
        },
        {
          "name" : "clientType",
          "type" : "Option[ClientType]",
          "description" : "From FIL IS _clientadministration.api.v1.get_ > _clientType_",
          "example" : "Some(ClientType.privateIndividual)"
        },
        {
          "name" : "nationality",
          "type" : "Option[String]",
          "description" : "From FIL IS _clientadministration.api.v1.get_ > _person.nationality_: codesISO_3166 - 1 - Country code of the nationality (country / nationality) - codetable: countries\n\n - as _person_ can be null - the default value is an empty String.",
          "example" : "Some(\"CH\")"
        },
        {
          "name" : "dateOfBirth",
          "type" : "Option[String]",
          "description" : "From FIL IS _clientadministration.api.v1.get_ > _person.dateOfBirth.\n\n - as _person_ and _person.dateOfBirth_ can be null - the default value is an empty String.",
          "example" : "Some(\"2003-12-23\")"
        },
        {
          "name" : "telephoneNumber",
          "type" : "Option[String]",
          "description" : "From domicil Address (addressType=11) the _communication.telephoneNumber_.",
          "example" : "Some(\"+417933333\")"
        },
        {
          "name" : "email",
          "type" : "Option[String]",
          "description" : "From domicil Address (addressType=11) the _communication.email.",
          "example" : "Some(\"my@email.ch\")"
        },
        {
          "name" : "clientKey",
          "type" : "Option[Long]",
          "description" : "From FIL IS _poa.poakey.api.v2.get_ > _assignmentClients[0].clientKey",
          "example" : "Some(defaultClientKey)"
        },
        {
          "name" : "signingAuthority",
          "type" : "Option[String]",
          "description" : "From FIL IS _poa.poakey.api.v2.get_ > _assignmentClients[0].signingAuthority_",
          "example" : "Some(\"INDIVIDUALLY\")"
        },
        {
          "name" : "signbaseStatus",
          "type" : "Option[String]",
          "description" : "From FIL IS _poa.poakey.api.v2.get_ > _assignmentClients[0].signbaseStatus_",
          "example" : "Some(\"ACTIVE\")"
        },
        {
          "name" : "legitimation",
          "type" : "Option[String]",
          "description" : "From FIL IS _poa.poakey.api.v2.get_ > _assignmentClients[0].legitimation_",
          "example" : "Some(\"HOLDER\")"
        },
        {
          "name" : "addresses",
          "type" : "Option[Seq[Address]]",
          "description" : "From FIL IS _addresses.api.v2.get_ > _addresses_",
          "example" : "Some(Seq(Address.example))"
        },
        {
          "name" : "assignmentAccounts",
          "type" : "Option[Seq[Account]]",
          "description" : "From FIL IS _accounts.api.v3.get_ > _accounts_",
          "example" : "Some(Seq(Account.example))"
        }
      ]
