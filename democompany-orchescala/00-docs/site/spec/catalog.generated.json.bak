    {
      "id" : "valiant.graviton.domain.customer.v1.schema.CustomerDetail",
      "name" : "CustomerDetail",
      "pkg" : "valiant.graviton.domain.customer.v1.schema",
      "kind" : "case",
      "importPath" : "valiant.graviton.domain.customer.v1.schema.CustomerDetail",
      "source" : "valiant-graviton/01-domain/src/main/scala/valiant/graviton/domain/customer/v1/schema/CustomerDetail.scala",
      "fields" : [
        {
          "name" : "id",
          "type" : "Option[String]",
          "description" : "Unique identifier",
          "example" : "Some(defaultGravitonEventId)"
        },
        {
          "name" : "customerId",
          "type" : "Option[String]",
          "description" : "Customer id",
          "example" : "Some(s\"$defaultClientKey\")"
        },
        {
          "name" : "targetCustomerGroup",
          "type" : "Option[Code]",
          "example" : "Some(customerGroupExample)"
        },
        {
          "name" : "targetSupport",
          "type" : "Option[Code]",
          "example" : "Some(Code.example)"
        },
        {
          "name" : "hasDescendants",
          "type" : "Option[Boolean]",
          "description" : "Does the customer have descendants",
          "example" : "Some(false)"
        },
        {
          "name" : "customerAtRisk",
          "type" : "Option[Boolean]",
          "description" : "Customer @ Risk",
          "example" : "Some(false)"
        },
        {
          "name" : "customerAtRiskDate",
          "type" : "Option[Iso8601DateTime]",
          "description" : "Date when the customer was set at risk",
          "example" : "None"
        },
        {
          "name" : "customerAtRiskComment",
          "type" : "Option[String]",
          "description" : "Reason why the customer is at risk",
          "example" : "None"
        },
        {
          "name" : "focusCustomerCare",
          "type" : "Option[Code]",
          "example" : "Some(Code.example)"
        },
        {
          "name" : "relationIds",
          "type" : "Option[Seq[String]]",
          "description" : "list of relation ids",
          "example" : "Some(Seq(defaultGravitonEventId))"
        },
        {
          "name" : "confession",
          "type" : "Option[Code]",
          "example" : "Some(Code.example)"
        },
        {
          "name" : "subjectToVat",
          "type" : "Option[Boolean]",
          "description" : "Does the customer have to pay VAT",
          "example" : "Some(false)"
        },
        {
          "name" : "referralCommissionAccountId",
          "type" : "Option[String]",
          "description" : "account id",
          "example" : "Some(s\"$defaultAccountKey\")"
        },
        {
          "name" : "referralCommissionAccountReference",
          "type" : "Option[String]",
          "description" : "iban of external account",
          "example" : "Some(defaultIban)"
        },
        {
          "name" : "promotionCode",
          "type" : "Option[String]",
          "description" : "A promotional code assigned to the customer",
          "example" : "Some(\"PROMO2024\")"
        },
        {
          "name" : "promotionCodeModificationDate",
          "type" : "Option[Iso8601DateTime]",
          "description" : "Automatically filled datetime field when promotionCode was last altered.",
          "example" : "Some(\"2024-03-12T01:00:00.000Z\")"
        },
        {
          "name" : "tenant",
          "type" : "Option[Int]",
          "example" : "Some(1)"
        }
      ]
    },
    {
