          "required" : true,
          "variants" : [
            "ExplicitProp"
          ]
        },
        {
          "name" : "formNr",
          "expression" : "= formNr",
          "description" : "A shortcut to set the additionalProperties: `[ formNr: \"{{formNr}}\", .. ]`. Defaults to `\"400600\"`.",
          "variants" : [
            "ExplicitProp"
          ]
        },
        {
          "name" : "searchValue",
          "expression" : "= searchValue",
          "description" : "A shortcut to set the additionalProperties: `[ searchValue: \"{{searchValue}}\", .. ]`. Defaults to `\"9\"`.",
          "variants" : [
            "ExplicitProp"
          ]
        },
        {
          "name" : "fileProps",
          "expression" : "= fileProps",
          "variants" : [
            "MultiProps"
          ]
        },
        {
          "name" : "additionalProperties",
          "expression" : "= additionalProperties",
          "description" : "A Seq with additionalProperties that will be placed in the 'value' object.",
          "variants" : [
            "SimpleProp"
          ]
        }
      ],
      "outputs" : [
      ]
    },
