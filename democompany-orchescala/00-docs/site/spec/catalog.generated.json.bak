          "required" : true
        },
        {
          "name" : "processDefinitionKey",
          "expression" : "= processDefinitionKey",
          "description" : "The processDefinitionKey of the Parent Process",
          "required" : true
        },
        {
          "name" : "processInstanceId",
          "expression" : "= processInstanceId",
          "description" : "The processInstanceId of the Parent Process: C7 -> UUID (String), C8 -> processInstanceKey (Long).",
          "required" : true
        },
        {
          "name" : "taskId",
          "expression" : "= taskId",
          "description" : "The taskId of the UserTask. Is set if the Event is for a UserTask (new pattern)."
        },
        {
          "name" : "taskDefinitionKey",
          "expression" : "= taskDefinitionKey",
          "description" : "The taskDefinitionKey of the UserTask. Is set if the Event is for a UserTask (new pattern - use Listener `valiant-bpmn:scripts/sendProcessEvent/taskListener.groovy`).\n\nThis can also be used for Call Activities (use Listener: `valiant-bpmn:scripts/sendProcessEvent/activityListener.groovy`), if they take longer and may be canceled for example."
        },
        {
          "name" : "responsibleUser",
          "expression" : "= responsibleUser",
          "description" : "Is set with the new pattern."
        },
        {
