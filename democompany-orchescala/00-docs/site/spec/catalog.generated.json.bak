          "description" : "Portfolio type",
          "example" : "Some(20)"
        },
        {
          "name" : "portfolioCurrency",
          "type" : "String",
          "description" : "Portfolio currency;\nThe currency dialog code is provided/returned for the attribute 'portfolioCurrency'.\nThis is an external representation of the currency reference.\nOnly for certain special 'currencies' such as precious metals; the value may differ from the corresponding ISO currency code (ISO 4217).\n\nsee `GET /banks/{bankNumber}/codetables/currencies`",
          "example" : "\"CHF\""
        },
        {
          "name" : "assetManagementCode",
          "type" : "Option[Int]",
          "description" : "see `GET /banks/{bankNumber}/codetables/assetManagementTypes`;\n- Format: int32",
          "example" : "Some(0)"
        },
        {
          "name" : "investmentObjective",
          "type" : "Int",
          "description" : "see `GET /banks/{bankNumber}/codetables/investmentObjectives`;\n\n- Be aware that this field is not mandatory according to FIL IS documentation - but will throw an error if not provided\n- Format: int32",
          "example" : "10"
        },
        {
          "name" : "managementArea",
          "type" : "Option[Int]",
          "description" : "see `GET /banks/{bankNumber}/codetables/portfolioManagementAreas`;\n- Format: int32",
          "example" : "Some(1000)"
        }
      ]
