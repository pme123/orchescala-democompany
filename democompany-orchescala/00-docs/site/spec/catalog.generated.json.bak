          "description" : "The id of the tenant this execution belongs to. Can be `null`\nif the execution belongs to no single tenant.",
          "example" : "Some(\"SomeDummyText\")"
        }
      ]
    },
    {
      "id" : "valiant.services.domain.camunda.v7.schema.ExternalTaskDto",
      "name" : "ExternalTaskDto",
      "pkg" : "valiant.services.domain.camunda.v7.schema",
      "kind" : "case",
      "importPath" : "valiant.services.domain.camunda.v7.schema.ExternalTaskDto",
      "source" : "valiant-services/01-domain/src/main/scala/valiant/services/domain/camunda/v7/schema/ExternalTaskDto.scala",
      "fields" : [
        {
          "name" : "activityId",
          "type" : "Option[String]",
          "description" : "The id of the activity that this external task belongs to.",
          "example" : "Some(\"Activity_1lswxfv\")"
        },
        {
          "name" : "activityInstanceId",
          "type" : "Option[String]",
          "description" : "The id of the activity instance that the external task belongs to.",
          "example" : "Some(\"Activity_1lswxfv:af36755f-421a-11f0-ac68-0a580a8302f3\")"
        },
        {
          "name" : "errorMessage",
          "type" : "Option[String]",
          "description" : "The full error message submitted with the latest reported failure executing this task; `null` if no\nfailure was reported previously or if no error message was submitted",
          "example" : "None"
        },
        {
          "name" : "executionId",
          "type" : "Option[String]",
          "description" : "The id of the execution that the external task belongs to.",
          "example" : "Some(\"af36755e-421a-11f0-ac68-0a580a8302f3\")"
        },
        {
          "name" : "id",
          "type" : "Option[String]",
          "description" : "The id of the external task.",
          "example" : "Some(\"af369c70-421a-11f0-ac68-0a580a8302f3\")"
        },
        {
          "name" : "lockExpirationTime",
          "type" : "Option[Iso8601DateTime]",
          "description" : "The date that the task's most recent lock expires or has expired.\n- Format: date-time",
          "example" : "Some(\"2025-06-05T16:43:02.537+0200\")"
        },
        {
          "name" : "processDefinitionId",
          "type" : "Option[String]",
          "description" : "The id of the process definition the external task is defined in.",
          "example" : "Some(\"63800e79-416e-11f0-ac68-0a580a8302f3\")"
        },
        {
          "name" : "processDefinitionKey",
          "type" : "Option[String]",
          "description" : "The key of the process definition the external task is defined in.",
          "example" : "Some(\"mycompany-myProcess\")"
        },
        {
          "name" : "processDefinitionVersionTag",
          "type" : "Option[String]",
          "description" : "The version tag of the process definition the external task is defined in.",
          "example" : "Some(\"2.12.5\")"
        },
        {
          "name" : "processInstanceId",
          "type" : "Option[String]",
          "description" : "The id of the process instance the external task belongs to.",
          "example" : "Some(\"af068c6c-421a-11f0-ac68-0a580a8302f3\")"
        },
        {
          "name" : "tenantId",
          "type" : "Option[String]",
          "description" : "The id of the tenant the external task belongs to.",
          "example" : "Some(\"6300\")"
        },
        {
          "name" : "retries",
          "type" : "Option[Int]",
          "description" : "The number of retries the task currently has left.\n- Format: int32",
          "example" : "None"
        },
        {
          "name" : "suspended",
          "type" : "Option[Boolean]",
          "description" : "A flag indicating whether the external task is suspended or not.",
          "example" : "Some(false)"
        },
        {
          "name" : "workerId",
          "type" : "Option[String]",
          "description" : "The id of the worker that posesses or posessed the most recent lock.",
          "example" : "Some(\"mycompany-worker-6cc978c689-jpcjgc1fadd77-67a2-42fe-b595-34f9988c897f\")"
        },
        {
          "name" : "topicName",
          "type" : "Option[String]",
          "description" : "The topic name of the external task.",
          "example" : "Some(\"mycompany-myTopicName\")"
        },
        {
          "name" : "priority",
          "type" : "Option[Long]",
          "description" : "The priority of the external task.\n- Format: int64",
          "example" : "Some(0L)"
        },
        {
          "name" : "businessKey",
          "type" : "Option[String]",
          "description" : "The business key of the process instance the external task belongs to.",
          "example" : "None"
        }
      ]
    },
    {
      "id" : "valiant.services.domain.camunda.v7.schema.HistoricProcessInstanceQueryDto",
