        "valiant.fil.is.domain.poa.v3.schema.PowerOfAttorney",
        "valiant.product.domain.loadPoas.v1.schema.PoaResult"
      ],
      "fields" : [
        {
          "name" : "allPoas",
          "type" : "Seq[PoaResult]"
        },
        {
          "name" : "givenPoas",
          "type" : "Seq[PoaResult]"
        },
        {
          "name" : "receivedPoas",
          "type" : "Seq[PoaResult]"
        },
        {
          "name" : "addresses",
          "type" : "Option[Seq[Address]]",
          "default" : "None",
          "description" : "MAP-10126: Reset variables to null at the end of each poas loop"
        },
        {
          "name" : "assignmentClients",
          "type" : "Option[Seq[AssignmentClientExtendedV2]]",
          "default" : "None",
          "description" : "MAP-10126: Reset variables to null at the end of each poas loop"
        },
        {
          "name" : "accounts",
          "type" : "Option[Seq[Account]]",
          "default" : "None",
          "description" : "MAP-10126: Reset variables to null at the end of each poas loop"
        }
      ],
      "topicName" : "valiant-product-loadPoasV1-MergePoas",
      "dsl" : "CustomTask",
      "ownerDescr" : "Merges per-POA details collected inside the MI subprocess into givenPoas/receivedPoas/allPoas.\n\nPort of camunda Groovy script `merge.poas.groovy` (formerly executionListener on subprocess end).\nRuns once per MI iteration."
    },
