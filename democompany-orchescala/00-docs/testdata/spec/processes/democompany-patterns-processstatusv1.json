  "status": "changed",
  "description": "Beispiel für das Pattern «Prozess-Status am Ende»: jedes Ende setzt `processStatus` -\nso sieht der Aufrufer (und die Simulation), wie der Prozess ausgegangen ist.\nIst der Antrag bewilligt (`approved`), endet der Prozess mit `succeeded`, sonst mit `canceled`.",
  "createdAt": "2026-11-02",
  "updatedAt": "2026-11-02T09:55:41+01:00",
  "variables": [],
  "timeToLive": "5",
  "steps": [
    {
      "id": "StartEvent",
      "kind": "start",
      "name": "Start",
      "status": "implemented"
    },
    {
      "id": "InitProcessTask",
      "kind": "service",
      "name": "Init Process",
      "status": "implemented",
      "topic": "democompany-patterns-processStatusV1",
      "manualOutMapping": false,
      "errors": [
        {
          "code": "output-mocked",
          "declared": true,
          "interrupting": true,
          "boundary": true,
          "pattern": "init-process",
          "steps": [
            {
              "id": "OutputMockedThrow",
              "kind": "event",
              "name": "output-mocked",
              "status": "implemented",
              "eventKind": "none",
              "eventDirection": "throw",
              "pattern": "init-process"
            },
            {
              "id": "OutputmockedEndEvent",
              "kind": "end",
              "name": "output-mocked",
              "status": "changed",
              "outputs": [
                {
                  "name": "processStatus",
                  "expression": "= \"output-mocked\""
                }
              ],
              "pattern": "init-process"
            }
          ]
        }
      ],
      "patterns": [
        {
          "id": "init-process"
        }
      ]
    },
    {
      "id": "ApprovedGateway",
      "kind": "gateway",
      "name": "Antrag bewilligt?",
      "status": "implemented",
      "gatewayType": "exclusive",
      "branches": [
        {
          "id": "ApprovedYesFlow",
          "label": "ja",
          "condition": "= approved",
          "steps": [
            {
              "id": "SucceededEndEvent",
              "kind": "end",
              "name": "succeeded",
              "status": "changed",
              "outputs": [
                {
                  "name": "processStatus",
                  "expression": "= \"succeeded\""
                }
              ],
              "patterns": [
                {
                  "id": "process-status",
                  "params": {
                    "processStatus": "succeeded"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "ApprovedNoFlow",
          "label": "nein",
          "condition": "= not(approved)",
          "steps": [
            {
              "id": "CanceledEndEvent",
              "kind": "end",
              "name": "canceled",
              "status": "changed",
              "outputs": [
                {
                  "name": "processStatus",
                  "expression": "= \"canceled\""
                }
              ],
              "patterns": [
                {
                  "id": "process-status",
                  "params": {
                    "processStatus": "canceled"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
